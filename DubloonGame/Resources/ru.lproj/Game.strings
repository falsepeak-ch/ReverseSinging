/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "Добро пожаловать на шоу! Выбери игру и покажи свой голос.";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "Бесплатные дубли закончились! Оформи Pro — и сцена твоя.";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "Игра";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "Разогрей голосовые связки и покажи лучшую пародию!";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "Реплика %1$d из %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "Выбери звук!";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "Выбери сцену!";

/* Button after a result: go on to the next sound */
"game.nextSound" = "Следующий";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "Обеим играм нужно тебя слышать: и озвучке сцены, и подражанию звукам. Микрофон просыпается только на время записи, всё остаётся на этом устройстве и никуда не отправляется. Твой худший дубль останется между вами двумя.";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "Приготовься…";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "Сначала послушай звук: %@. А потом покажи лучшую пародию!";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "Поехали… приготовься!";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "Давай, давай! Не стесняйся!";

/* Said while the take is being judged */
"game.host.scoring" = "Хм, дай-ка переслушаю…";

/* Reaction to a top score */
"game.host.grade.top" = "Невероятно! Вас не отличить!";

/* Reaction to a good score */
"game.host.grade.good" = "Отлично! У тебя получается.";

/* Reaction to a near miss */
"game.host.grade.close" = "Почти! Ещё разок?";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "Ха! Смело… попробуй ещё!";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "Совет: повторяй, где звук взрывается и где замолкает.";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "Совет: следуй за высотой вверх и вниз.";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "Совет: передай тембр — с придыханием или с жужжанием.";

/* Tip when length was the weakest part */
"game.host.tip.length" = "Совет: тяни столько же, сколько оригинал.";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "Реплика: %@! Посмотри один раз и вступай ровно в начале.";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "Твой выход! Держи темп!";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "Совет: вступай ровно когда персонаж начинает.";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "Совет: держи темп слогов.";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "Совет: повторяй громкие и тихие места.";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "Снято! Посмотришь свою озвучку?";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "Уже озвучено! Ещё раз или дальше.";

/* Accessibility label of the trophy on the home stage that opens the Game Center leaderboards */
"game.leaderboards" = "Таблицы лидеров";

/* Title of the card that explains reminders before iOS asks for notification permission */
"game.reminder.primer.title" = "Не пропусти шоу";

/* Body of that card: what the reminders are and that they can be turned off in Settings */
"game.reminder.primer.body" = "Вечером я напомню о звуке, который стоит попробовать, и о конце недельной гонки. Это можно отключить в Настройках в любой момент.";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "Продолжить";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "Время шоу!";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "Звук этого вечера: %@. Сможешь повторить?";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "Сцена из фильма ждёт твоего голоса. Свет, микрофон, мотор!";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "Сцена готова, зал разогрет. Сыграй раунд!";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "Последний день недельной гонки";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "У тебя %d очков на этой неделе. Ещё один раунд может поднять тебя выше!";

/* Settings switch: play fewer of the game's sound effects */
"game.settings.fewerSounds" = "Меньше звуковых эффектов";

/* Under that switch: what it keeps and what it drops */
"game.settings.fewerSounds.desc" = "Без щелчков и свистов. Звёзды и фанфары остаются.";

/* Under the Sound effects switch: what the game's sounds are */
"game.settings.soundEffects.desc" = "Щелчки, звёзды, фанфары и зрители шоу.";

/* Under Unlock Dubloon Pro in the game's settings: what Pro gives */
"game.settings.unlock.desc" = "Первые 3 дубля бесплатно. С Dubloon Pro каждый раунд без ограничений.";

/* Help, in the game's words. Same keys as the shared Help; the game reads these first. */
"help.gettingStarted.1.q" = "Что такое Dubloon the Game?";
"help.gettingStarted.1.a" = "Голосовое игровое шоу с двумя играми. «Озвучка сцены»: озвучь сцену из фильма реплика за репликой и получи оценку. «Имитация звуков»: подражай звуку и выиграй до трёх звёзд. Ведущий проведёт тебя через каждый раунд.";
"help.gettingStarted.2.q" = "Это бесплатно?";
"help.gettingStarted.2.a" = "Обе игры бесплатны. Первые 3 дубля бесплатны, они считаются сразу по обеим играм. После этого каждая сцена и каждый звук всё равно открываются, а Dubloon Pro позволяет записывать без ограничений.";
"help.dub.1.q" = "Как озвучить сцену?";
"help.dub.1.a" = "Открой «Озвучку сцены» и выбери сцену. Для каждой реплики нажми на динамик, чтобы услышать оригинал, потом нажми микрофон: будет три удара отсчёта, а микрофон сам закроется, когда реплика закончится. Стрелками переходи между репликами.";
"help.dub.4.q" = "Как посмотреть свою озвучку или поделиться ею?";
"help.dub.4.a" = "На последней реплике нажми «Смотреть мою озвучку», чтобы увидеть свои дубли в фильме. Нажми «Сделать видео», чтобы получить вертикальное видео для TikTok, Reels or Shorts, а если ты снимал, то с кадрами Booth Cam под сценой.";
"help.imitate.1.q" = "Как работает «Имитация звуков»?";
"help.imitate.1.a" = "Выбери звук, нажми на динамик, чтобы его услышать, потом нажми микрофон и воспроизведи звук сам. Ведущий оценивает твой ритм, высоту, тембр и длину и зажигает до трёх звёзд. Лучший результат сохраняется, так что можно вернуться и побить его.";
"help.imitate.3.q" = "Можно ли поделиться попыткой?";
"help.imitate.3.a" = "Да. После оценки нажми «Сделать видео»: вертикальное видео со звуком, твоей попыткой и оценкой. Если включён Booth Cam, в нём будет и твоё лицо.";
"help.booth.1.q" = "Что такое Booth Cam?";
"help.booth.1.a" = "Booth Cam снимает твоё лицо фронтальной камерой, пока ты играешь, чтобы твоя реакция попала в видео. Включи её клавишей камеры в верхней части раунда или в Настройках. Кадры остаются на твоём устройстве.";
"help.booth.2.q" = "Как сделать видео?";
"help.booth.2.a" = "В «Озвучке сцены» дойди до последней реплики и нажми «Сделать видео». В «Имитации звуков» нажми «Сделать видео» после оценки. В обоих случаях получится вертикальное видео для TikTok, Reels or Shorts. Перед рендером озвучки игра показывает, чья это сцена, чтобы ты сохранил авторство, когда делишься.";
"help.pro.1.q" = "Что открывает Dubloon Pro?";
"help.pro.1.a" = "Безлимитные дубли в обеих играх, «Озвучке сцены» и «Имитации звуков». Без Pro первые 3 дубля бесплатны. Pro — это разовая покупка или подписка. Он принадлежит этой игре: покупка в приложении Dubloon не переносится.";
"help.troubleshooting.1.q" = "Игра меня не слышит.";
"help.troubleshooting.1.a" = "Проверь, что игре можно пользоваться микрофоном: в приложении Настройки открой Dubloon Game и включи «Микрофон». Если звук занят другим приложением, например звонком, заверши его и попробуй снова.";
"help.troubleshooting.4.q" = "Booth Cam не включается.";
"help.troubleshooting.4.a" = "Для неё игре нужна камера. В приложении Настройки открой Dubloon Game и включи «Камера».";
