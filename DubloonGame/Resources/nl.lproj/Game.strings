/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "Welkom bij de show! Kies een spel en laat je stem horen.";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "Je gratis takes zijn op! Word Pro en het podium is van jou.";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "De Game";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "Warm je stembanden op en doe je beste imitatie!";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "Zin %1$d van %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "Kies een geluid!";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "Kies een scène!";

/* Button after a result: go on to the next sound */
"game.nextSound" = "Volgende";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "Beide spellen moeten je horen: een scène nasynchroniseren of een geluid nadoen. De microfoon wordt alleen wakker tijdens het opnemen, alles blijft op dit apparaat en er wordt nooit iets geüpload. Je slechtste take blijft tussen jullie tweeën.";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "Maak je klaar…";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "Luister eerst naar het geluid: %@. Geef me dan je beste imitatie!";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "Daar gaan we… maak je klaar!";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "Ga ga ga! Niet inhouden!";

/* Said while the take is being judged */
"game.host.scoring" = "Hmm, even terugluisteren…";

/* Reaction to a top score */
"game.host.grade.top" = "Ongelooflijk! Ik hoor geen verschil!";

/* Reaction to a good score */
"game.host.grade.good" = "Goed zo! Je hebt het.";

/* Reaction to a near miss */
"game.host.grade.close" = "Bijna! Nog een keer?";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "Ha! Gedurfd… probeer opnieuw!";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "Tip: volg waar het uitbarst en waar het stopt.";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "Tip: volg de toonhoogte omhoog en omlaag.";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "Tip: kopieer de klank, ademend of zoemend.";

/* Tip when length was the weakest part */
"game.host.tip.length" = "Tip: laat het net zo lang duren als het origineel.";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "De zin van %@! Kijk één keer en val in zodra die begint.";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "Jij bent! Hou het tempo bij!";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "Tip: val in zodra het personage begint.";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "Tip: hou het tempo van de lettergrepen bij.";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "Tip: kopieer het harde en het zachte.";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "En… cut! Wil je je nasynchronisatie zien?";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "Al ingesproken! Nog eens of verder.";

/* Accessibility label of the trophy on the home stage that opens the Game Center leaderboards */
"game.leaderboards" = "Ranglijsten";

/* Title of the card that explains reminders before iOS asks for notification permission */
"game.reminder.primer.title" = "Mis de show niet";

/* Body of that card: what the reminders are and that they can be turned off in Settings */
"game.reminder.primer.body" = "Ik herinner je 's avonds aan een geluid om te proberen, en voordat de weekrace afloopt. Je kunt dit altijd uitzetten in Instellingen.";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "Ga door";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "Showtime!";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "Het geluid van vanavond is %@. Lukt het jou?";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "Een filmscène wacht op je stem. Licht, microfoon, actie!";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "Het podium staat klaar en het publiek is warm. Kom een ronde spelen!";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "Laatste dag van de weekrace";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "Je hebt deze week %d punten. Nog één ronde kan je hoger op de lijst brengen!";

/* Settings switch: play fewer of the game's sound effects */
"game.settings.fewerSounds" = "Minder geluidseffecten";

/* Under that switch: what it keeps and what it drops */
"game.settings.fewerSounds.desc" = "Geen tik- of zwiepgeluiden. Sterren en fanfares blijven.";

/* Under the Sound effects switch: what the game's sounds are */
"game.settings.soundEffects.desc" = "Tikjes, sterren, fanfares en publiek van de show.";

/* Under Unlock Dubloon Pro in the game's settings: what Pro gives */
"game.settings.unlock.desc" = "Je eerste 3 takes zijn gratis. Met Dubloon Pro is elke ronde onbeperkt.";

/* Help, in the game's words. Same keys as the shared Help; the game reads these first. */
"help.gettingStarted.1.q" = "Wat is Dubloon the Game?";
"help.gettingStarted.1.a" = "Een stemgameshow met twee spellen. Filmscène dubben: zet je stem in een filmscène, zin voor zin, en krijg een score. Geluiden nadoen: doe een geluid na en win tot drie sterren. De presentator loodst je door elke ronde.";
"help.gettingStarted.2.q" = "Is het gratis?";
"help.gettingStarted.2.a" = "Beide spellen zijn gratis te spelen. Je eerste 3 takes zijn gratis, geteld over beide spellen samen. Daarna kun je nog steeds elke scène en elk geluid openen, en met Dubloon Pro blijf je onbeperkt opnemen.";
"help.dub.1.q" = "Hoe dub ik een scène?";
"help.dub.1.a" = "Open Filmscène dubben en kies een scène. Tik bij elke zin op de luidspreker om het origineel te horen en druk dan op de microfoon: je krijgt drie tellen aftellen, en de microfoon sluit vanzelf als de zin afgelopen is. Gebruik de pijlen om tussen zinnen te wisselen.";
"help.dub.4.q" = "Hoe bekijk of deel ik mijn dub?";
"help.dub.4.a" = "Tik bij de laatste zin op Mijn versie bekijken om je takes in de film te zien. Tik op Maak video voor een verticale video die klaar is voor TikTok, Reels or Shorts, met je Booth Cam-beelden onder de scène als je die hebt gefilmd.";
"help.imitate.1.q" = "Hoe werkt Geluiden nadoen?";
"help.imitate.1.a" = "Kies een geluid, tik op de luidspreker om het te horen, druk dan op de microfoon en maak het geluid zelf. De presentator beoordeelt je ritme, toonhoogte, klank en lengte en laat tot drie sterren oplichten. Je beste score wordt bewaard, dus je kunt terugkomen om hem te verbeteren.";
"help.imitate.3.q" = "Kan ik een poging delen?";
"help.imitate.3.a" = "Ja. Tik na een score op Maak video: een verticale video met het geluid, jouw poging en je score. Met Booth Cam aan is ook je gezicht erin te zien.";
"help.booth.1.q" = "Wat is Booth Cam?";
"help.booth.1.a" = "Booth Cam filmt je gezicht met de camera aan de voorkant terwijl je speelt, zodat je reactie in de video kan. Zet hem aan met de cameratoets bovenaan een ronde of in Instellingen. De beelden blijven op je apparaat.";
"help.booth.2.q" = "Hoe maak ik een video?";
"help.booth.2.a" = "Ga in Filmscène dubben naar de laatste zin en tik op Maak video. Tik in Geluiden nadoen na een score op Maak video. Beide maken een verticale video voor TikTok, Reels or Shorts. Voordat een dub wordt gerenderd, laat het spel zien van wie de scène is, zodat je de credits behoudt als je deelt.";
"help.pro.1.q" = "Wat ontgrendelt Dubloon Pro?";
"help.pro.1.a" = "Onbeperkt takes in beide spellen, Filmscène dubben en Geluiden nadoen. Zonder Pro zijn je eerste 3 takes gratis. Pro is een eenmalige aankoop of een abonnement. Het hoort bij dit spel: een aankoop in de Dubloon-app wordt niet overgenomen.";
"help.troubleshooting.1.q" = "Het spel hoort me niet.";
"help.troubleshooting.1.a" = "Check of het spel de microfoon mag gebruiken: open Dubloon Game in de Instellingen-app en zet Microfoon aan. Gebruikt een andere app de audio, zoals een gesprek, beëindig dat dan en probeer het opnieuw.";
"help.troubleshooting.4.q" = "Booth Cam gaat niet aan.";
"help.troubleshooting.4.a" = "Het spel heeft daarvoor de camera nodig. Open Dubloon Game in de Instellingen-app en zet Camera aan.";

/* The import gate's third answer, which opens the numbered steps for getting a scene */
"game.dubGate.showSteps" = "Laat zien hoe, stap voor stap";
