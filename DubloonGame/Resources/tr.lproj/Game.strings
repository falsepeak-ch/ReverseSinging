/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "Şova hoş geldin! Bir oyun seç ve sesini duyalım.";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "Ücretsiz çekimlerin bitti! Pro'ya geç, sahne senin.";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "Oyun";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "Ses tellerini ısıt ve en iyi taklidini yap!";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "Replik %1$d / %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "Bir ses seç!";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "Bir sahne seç!";

/* Button after a result: go on to the next sound */
"game.nextSound" = "Sonraki";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "İki oyunun da seni duyması gerek: bir sahneyi seslendirirken ve bir sesi taklit ederken. Mikrofon sadece kayıt sırasında uyanır, her şey bu cihazda kalır ve hiçbir şey hiçbir yere yüklenmez. En kötü çekimin ikinizin arasında kalır.";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "Hazırlan…";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "Önce sesi dinle: %@. Sonra en iyi taklidini yap!";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "Başlıyoruz… hazırlan!";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "Hadi hadi! Çekinme!";

/* Said while the take is being judged */
"game.host.scoring" = "Hmm, bir daha dinleyeyim…";

/* Reaction to a top score */
"game.host.grade.top" = "İnanılmaz! Sizi ayırt edemiyorum!";

/* Reaction to a good score */
"game.host.grade.good" = "Harika! Bu iş sende.";

/* Reaction to a near miss */
"game.host.grade.close" = "Az kaldı! Bir daha?";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "Ha! Cesur seçim… tekrar dene!";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "İpucu: patladığı ve durduğu yerleri yakala.";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "İpucu: perdesini aşağı yukarı takip et.";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "İpucu: dokusunu taklit et, nefesli ya da vızıltılı.";

/* Tip when length was the weakest part */
"game.host.tip.length" = "İpucu: orijinali kadar uzat.";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "Sıra %@ repliğinde! Bir kez izle, tam başladığı anda gir.";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "Sıra sende! Temposunu yakala!";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "İpucu: karakter konuşmaya başladığı anda gir.";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "İpucu: hecelerin temposunu yakala.";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "İpucu: yüksek ve alçak yerleri taklit et.";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "Kestik! Seslendirmeni izlemek ister misin?";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "Zaten seslendirildi! Tekrar ya da devam.";

/* Accessibility label of the trophy on the home stage that opens the Game Center leaderboards */
"game.leaderboards" = "Lider tabloları";

/* Title of the card that explains reminders before iOS asks for notification permission */
"game.reminder.primer.title" = "Şovu kaçırma";

/* Body of that card: what the reminders are and that they can be turned off in Settings */
"game.reminder.primer.body" = "Akşamları denemen için bir ses ve haftalık yarış bitmeden bir hatırlatma göndereceğim. Bunu istediğin zaman Ayarlar'dan kapatabilirsin.";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "Devam";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "Şov zamanı!";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "Bu akşamın sesi: %@. Becerebilir misin?";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "Bir film sahnesi sesini bekliyor. Işık, mikrofon, motor!";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "Sahne hazır, seyirci ısındı. Gel bir tur oyna!";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "Haftalık yarışın son günü";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "Bu hafta %d puanın var. Bir tur daha seni yukarı taşıyabilir!";

/* Settings switch: play fewer of the game's sound effects */
"game.settings.fewerSounds" = "Daha az ses efekti";

/* Under that switch: what it keeps and what it drops */
"game.settings.fewerSounds.desc" = "Dokunma ve geçiş sesleri yok. Yıldızlar ve fanfarlar çalmaya devam eder.";

/* Under the Sound effects switch: what the game's sounds are */
"game.settings.soundEffects.desc" = "Şovun dokunma sesleri, yıldızları, fanfarları ve seyircisi.";

/* Under Unlock Dubloon Pro in the game's settings: what Pro gives */
"game.settings.unlock.desc" = "İlk 3 çekimin ücretsiz. Dubloon Pro ile her tur sınırsız.";

/* Help, in the game's words. Same keys as the shared Help; the game reads these first. */
"help.gettingStarted.1.q" = "Dubloon the Game nedir?";
"help.gettingStarted.1.a" = "İki oyunlu bir ses oyunu şovu. Sahne seslendirme: bir film sahnesine replik replik sesini koy ve puan al. Ses taklidi: bir sesi taklit et ve üç yıldıza kadar kazan. Sunucu seni her turda yönlendirir.";
"help.gettingStarted.2.q" = "Ücretsiz mi?";
"help.gettingStarted.2.a" = "İki oyun da ücretsiz oynanır. İlk 3 çekimin ücretsiz ve iki oyun birlikte sayılır. Sonrasında her sahne ve her ses yine açılır, Dubloon Pro ise sınırsız kayıt yapmanı sağlar.";
"help.dub.1.q" = "Bir sahneyi nasıl seslendiririm?";
"help.dub.1.a" = "Sahne seslendirme'yi aç ve bir sahne seç. Her replikte orijinali duymak için hoparlöre dokun, sonra mikrofona bas: üç vuruşluk geri sayım gelir ve replik bitince mikrofon kendiliğinden kapanır. Replikler arasında geçmek için oklara dokun.";
"help.dub.4.q" = "Seslendirmemi nasıl izler veya paylaşırım?";
"help.dub.4.a" = "Son replikte çekimlerini filmin içinde görmek için Kendi seslendirmemi izle'ye dokun. TikTok, Reels or Shorts için hazır dikey bir video almak için Video yap'a dokun; çektiysen Booth Cam görüntülerin sahnenin altında yer alır.";
"help.imitate.1.q" = "Ses taklidi nasıl çalışır?";
"help.imitate.1.a" = "Bir ses seç, duymak için hoparlöre dokun, sonra mikrofona bas ve sesi kendin çıkar. Sunucu ritmini, perdeni, tınını ve süreni puanlar ve üç yıldıza kadar yakar. En iyi sonucun saklanır, böylece dönüp onu geçebilirsin.";
"help.imitate.3.q" = "Bir denemeyi paylaşabilir miyim?";
"help.imitate.3.a" = "Evet. Puandan sonra Video yap'a dokun: sesi, denemeni ve puanını içeren dikey bir video. Booth Cam açıksa yüzün de içinde olur.";
"help.booth.1.q" = "Booth Cam nedir?";
"help.booth.1.a" = "Booth Cam sen oynarken yüzünü ön kamerayla çeker, böylece tepkin videoya girebilir. Turun üstündeki kamera tuşuyla ya da Ayarlar'dan aç. Görüntüler cihazında kalır.";
"help.booth.2.q" = "Nasıl video yaparım?";
"help.booth.2.a" = "Sahne seslendirme'de son repliğe gel ve Video yap'a dokun. Ses taklidi'nde puandan sonra Video yap'a dokun. İkisi de TikTok, Reels or Shorts için dikey bir video yapar. Bir seslendirme işlenmeden önce oyun sahnenin kime ait olduğunu gösterir, böylece paylaşırken emeği korursun.";
"help.pro.1.q" = "Dubloon Pro neleri açar?";
"help.pro.1.a" = "İki oyunda da, Sahne seslendirme ve Ses taklidi'nde, sınırsız çekim. Olmadan ilk 3 çekimin ücretsiz. Pro tek seferlik satın alma ya da abonelik olarak gelir. Bu oyuna aittir: Dubloon uygulamasındaki bir satın alma buraya geçmez.";
"help.troubleshooting.1.q" = "Oyun beni duymuyor.";
"help.troubleshooting.1.a" = "Oyunun mikrofonu kullanabildiğinden emin ol: Ayarlar uygulamasında Dubloon Game'i aç ve Mikrofon'u aç. Sesi başka bir uygulama kullanıyorsa, örneğin bir arama, onu bitir ve tekrar dene.";
"help.troubleshooting.4.q" = "Booth Cam açılmıyor.";
"help.troubleshooting.4.a" = "Oyunun bunun için kameraya ihtiyacı var. Ayarlar uygulamasında Dubloon Game'i aç ve Kamera'yı aç.";
