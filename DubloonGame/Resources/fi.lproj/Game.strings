/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "Tervetuloa showhun! Valitse peli ja anna äänesi kuulua.";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "Ilmaiset otot loppuivat! Hanki Pro, niin lava on sinun.";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "Peli";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "Lämmittele äänihuulet ja tee paras imitaatiosi!";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "Repliikki %1$d/%2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "Valitse ääni!";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "Valitse kohtaus!";

/* Button after a result: go on to the next sound */
"game.nextSound" = "Seuraava";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "Molempien pelien pitää kuulla sinut: kohtausta dubatessa tai ääntä matkiessa. Mikrofoni herää vain äänityksen ajaksi, kaikki pysyy tällä laitteella eikä mitään lähetetä koskaan minnekään. Surkein otoksesi jää teidän kahden väliseksi.";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "Valmistaudu…";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "Kuuntele ensin ääni: %@. Anna sitten paras imitaatiosi!";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "Nyt mennään… valmistaudu!";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "Anna mennä! Älä jarruttele!";

/* Said while the take is being judged */
"game.host.scoring" = "Hmm, kuuntelen uudestaan…";

/* Reaction to a top score */
"game.host.grade.top" = "Uskomatonta! En erota teitä!";

/* Reaction to a good score */
"game.host.grade.good" = "Hienoa! Sinä osaat.";

/* Reaction to a near miss */
"game.host.grade.close" = "Melkein! Vielä kerran?";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "Hah! Rohkeaa… yritä uudestaan!";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "Vinkki: osu siihen, missä ääni pamahtaa ja taukoaa.";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "Vinkki: seuraa sävelkorkeutta ylös ja alas.";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "Vinkki: matki sointia, henkäilevää tai surisevaa.";

/* Tip when length was the weakest part */
"game.host.tip.length" = "Vinkki: anna kestää yhtä kauan kuin alkuperäinen.";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "Hahmon %@ repliikki! Katso kerran ja tule mukaan heti alussa.";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "Sinun vuorosi! Pysy tahdissa!";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "Vinkki: tule mukaan heti kun hahmo alkaa puhua.";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "Vinkki: pysy tavujen tahdissa.";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "Vinkki: matki voimakkaat ja hiljaiset kohdat.";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "Poikki! Haluatko katsoa dubbauksesi?";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "Jo dubattu! Uudestaan vai eteenpäin.";

/* Accessibility label of the trophy on the home stage that opens the Game Center leaderboards */
"game.leaderboards" = "Tulostaulut";

/* Title of the card that explains reminders before iOS asks for notification permission */
"game.reminder.primer.title" = "Älä missaa showta";

/* Body of that card: what the reminders are and that they can be turned off in Settings */
"game.reminder.primer.body" = "Muistutan sinua illalla kokeiltavasta äänestä ja ennen viikkokisan loppua. Voit poistaa tämän käytöstä Asetuksissa milloin tahansa.";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "Jatka";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "Show alkaa!";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "Illan ääni on %@. Osaatko sen?";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "Elokuvakohtaus odottaa ääntäsi. Valot, mikki, kamera!";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "Lava on valmis ja yleisö odottaa. Tule pelaamaan kierros!";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "Viikkokisan viimeinen päivä";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "Sinulla on tällä viikolla %d pistettä. Yksi kierros lisää voi nostaa sinua listalla!";

/* Settings switch: play fewer of the game's sound effects */
"game.settings.fewerSounds" = "Vähemmän ääniefektejä";

/* Under that switch: what it keeps and what it drops */
"game.settings.fewerSounds.desc" = "Ei napautus- eikä suhahdusääniä. Tähdet ja fanfaarit soivat yhä.";

/* Under the Sound effects switch: what the game's sounds are */
"game.settings.soundEffects.desc" = "Shown napautukset, tähdet, fanfaarit ja yleisö.";

/* Under Unlock Dubloon Pro in the game's settings: what Pro gives */
"game.settings.unlock.desc" = "3 ensimmäistä ottoa ovat ilmaisia. Dubloon Prolla jokainen kierros on rajaton.";
