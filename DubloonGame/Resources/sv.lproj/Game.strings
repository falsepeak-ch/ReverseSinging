/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "Välkommen till showen! Välj ett spel och låt oss höra rösten.";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "Dina gratistagningar är slut! Skaffa Pro så är scenen din.";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "Spelet";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "Värm upp stämbanden och gör din bästa imitation!";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "Replik %1$d av %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "Välj ett ljud!";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "Välj en scen!";

/* Button after a result: go on to the next sound */
"game.nextSound" = "Nästa";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "Båda spelen måste höra dig: dubbning av en scen eller härmning av ett ljud. Mikrofonen vaknar bara medan du spelar in, allt stannar på den här enheten och ingenting laddas någonsin upp. Din sämsta tagning stannar mellan er två.";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "Gör dig redo …";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "Lyssna först på ljudet: %@. Ge mig sen din bästa imitation!";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "Nu kör vi … gör dig redo!";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "Kör, kör, kör! Håll inte igen!";

/* Said while the take is being judged */
"game.host.scoring" = "Hmm, jag lyssnar igen …";

/* Reaction to a top score */
"game.host.grade.top" = "Otroligt! Jag hör ingen skillnad!";

/* Reaction to a good score */
"game.host.grade.good" = "Snyggt! Du har det.";

/* Reaction to a near miss */
"game.host.grade.close" = "Nära! En gång till?";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "Ha! Modigt … försök igen!";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "Tips: träffa där det smäller och där det tystnar.";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "Tips: följ tonhöjden upp och ner.";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "Tips: härma klangen, luftig eller surrig.";

/* Tip when length was the weakest part */
"game.host.tip.length" = "Tips: låt det vara lika långt som originalet.";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "%@ har repliken! Titta en gång och kom in precis i början.";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "Din tur! Håll tempot!";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "Tips: kom in precis när figuren börjar prata.";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "Tips: håll tempot i stavelserna.";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "Tips: härma det starka och det svaga.";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "Tagning klar! Vill du se din dubbning?";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "Redan dubbad! Igen eller vidare.";

/* Accessibility label of the trophy on the home stage that opens the Game Center leaderboards */
"game.leaderboards" = "Topplistor";

/* Title of the card that explains reminders before iOS asks for notification permission */
"game.reminder.primer.title" = "Missa inte showen";

/* Body of that card: what the reminders are and that they can be turned off in Settings */
"game.reminder.primer.body" = "Jag påminner dig på kvällen om ett ljud att testa, och innan veckans tävling tar slut. Du kan stänga av det i Inställningar när du vill.";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "Fortsätt";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "Showtime!";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "Kvällens ljud är %@. Klarar du det?";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "En filmscen väntar på din röst. Ljus, mikrofon, action!";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "Scenen är redo och publiken är varm. Kom och spela en runda!";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "Sista dagen av veckans tävling";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "Du har %d poäng den här veckan. En runda till kan ta dig uppåt på listan!";

/* Settings switch: play fewer of the game's sound effects */
"game.settings.fewerSounds" = "Färre ljudeffekter";

/* Under that switch: what it keeps and what it drops */
"game.settings.fewerSounds.desc" = "Inga tryck- eller svischljud. Stjärnor och fanfarer spelas fortfarande.";

/* Under the Sound effects switch: what the game's sounds are */
"game.settings.soundEffects.desc" = "Showens klick, stjärnor, fanfarer och publik.";

/* Under Unlock Dubloon Pro in the game's settings: what Pro gives */
"game.settings.unlock.desc" = "Dina första 3 tagningar är gratis. Med Dubloon Pro är varje runda obegränsad.";
