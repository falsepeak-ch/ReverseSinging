/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "¡Bienvenido al show! Elige un juego y que se oiga esa voz.";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "¡Se acabaron tus tomas gratis! Hazte Pro y el escenario es tuyo.";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "El Juego";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "¡Calienta esas cuerdas vocales y haz tu mejor imitación!";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "Frase %1$d de %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "¡Elige un sonido!";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "¡Elige una escena!";

/* Button after a result: go on to the next sound */
"game.nextSound" = "Siguiente";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "Los dos juegos necesitan oírte: doblando una escena o imitando un sonido. El micro solo se despierta mientras grabas, todo se queda en este dispositivo y nunca se sube nada. Tu peor toma se queda entre vosotros dos.";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "Prepárate…";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "Escucha primero el sonido: %@. ¡Luego dame tu mejor imitación!";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "Allá vamos… ¡prepárate!";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "¡Vamos, vamos! ¡Sin miedo!";

/* Said while the take is being judged */
"game.host.scoring" = "Mmm, déjame escucharlo…";

/* Reaction to a top score */
"game.host.grade.top" = "¡Increíble! ¡No os distingo!";

/* Reaction to a good score */
"game.host.grade.good" = "¡Muy bien! Lo tienes.";

/* Reaction to a near miss */
"game.host.grade.close" = "¡Casi! ¿Otra vez?";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "¡Ja! Atrevido… ¡inténtalo otra vez!";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "Truco: imita dónde estalla y dónde se calla.";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "Truco: sigue su tono hacia arriba y abajo.";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "Truco: copia su textura, soplada o vibrante.";

/* Tip when length was the weakest part */
"game.host.tip.length" = "Truco: haz que dure lo mismo que el original.";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "¡Frase de %@! Mírala una vez y entra justo cuando empiece.";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "¡Te toca! ¡Sigue su ritmo!";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "Truco: entra justo cuando empieza a hablar.";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "Truco: sigue el ritmo de sus sílabas.";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "Truco: copia sus fuertes y sus suaves.";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "¡Y corten! ¿Quieres ver tu doblaje?";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "¡Ya está doblada! Repite o sigue.";

/* Accessibility label of the trophy on the home stage that opens the Game Center leaderboards */
"game.leaderboards" = "Clasificaciones";

/* Title of the card that explains reminders before iOS asks for notification permission */
"game.reminder.primer.title" = "No te pierdas el show";

/* Body of that card: what the reminders are and that they can be turned off in Settings */
"game.reminder.primer.body" = "Te avisaré por la tarde con un sonido para probar y antes de que acabe la carrera semanal. Puedes desactivarlo en Ajustes cuando quieras.";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "Continuar";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "¡Empieza el show!";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "El sonido de esta noche es %@. ¿Lo bordas?";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "Una escena te espera para que le pongas voz. ¡Luces, micro, acción!";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "El escenario está listo y el público, con ganas. ¡Ven a jugar una ronda!";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "Último día de la carrera semanal";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "Llevas %d puntos esta semana. ¡Una ronda más podría subirte en la clasificación!";

/* Settings switch: play fewer of the game's sound effects */
"game.settings.fewerSounds" = "Menos efectos de sonido";

/* Under that switch: what it keeps and what it drops */
"game.settings.fewerSounds.desc" = "Sin toques ni barridos. Las estrellas y fanfarrias siguen sonando.";

/* Under the Sound effects switch: what the game's sounds are */
"game.settings.soundEffects.desc" = "Toques, estrellas, fanfarrias y público del show.";

/* Under Unlock Dubloon Pro in the game's settings: what Pro gives */
"game.settings.unlock.desc" = "Tus 3 primeras tomas son gratis. Con Dubloon Pro, todas las rondas son ilimitadas.";

/* Help, in the game's words. Same keys as the shared Help; the game reads these first. */
"help.gettingStarted.1.q" = "¿Qué es Dubloon the Game?";
"help.gettingStarted.1.a" = "Un concurso de voz con dos juegos. Doblaje de escenas: pon tu voz en una escena de película, frase a frase, y recibe una puntuación. Imitación de sonidos: imita un sonido y gana hasta tres estrellas. El presentador te acompaña en cada ronda.";
"help.gettingStarted.2.q" = "¿Es gratis?";
"help.gettingStarted.2.a" = "Los dos juegos son gratis. Tus primeras 3 tomas son gratis, contadas entre ambos juegos. Después, cada escena y cada sonido siguen abiertos, y Dubloon Pro te deja seguir grabando sin límite.";
"help.dub.1.q" = "¿Cómo doblo una escena?";
"help.dub.1.a" = "Abre Doblaje de escenas y elige una escena. En cada frase, toca el altavoz para oír el original y luego pulsa el micro: tienes tres toques de cuenta atrás, y el micro se cierra solo cuando termina la frase. Usa las flechas para moverte entre frases.";
"help.dub.4.q" = "¿Cómo veo o comparto mi doblaje?";
"help.dub.4.a" = "En la última frase, toca Ver mi doblaje para ver tus tomas dentro de la película. Toca Crear vídeo para obtener un vídeo vertical listo para TikTok, Reels or Shorts, con las imágenes de la cámara de cabina bajo la escena si grabaste alguna.";
"help.imitate.1.q" = "¿Cómo funciona la Imitación de sonidos?";
"help.imitate.1.a" = "Elige un sonido, toca el altavoz para oírlo, pulsa el micro y haz tú el sonido. El presentador puntúa tu ritmo, tono, timbre y duración, y enciende hasta tres estrellas. Se guarda tu mejor marca, así que puedes volver y superarla.";
"help.imitate.3.q" = "¿Puedo compartir un intento?";
"help.imitate.3.a" = "Sí. Después de una puntuación, toca Crear vídeo: un vídeo vertical con el sonido, tu intento y tu puntuación. Con la cámara de cabina encendida, también sale tu cara.";
"help.booth.1.q" = "¿Qué es la cámara de cabina?";
"help.booth.1.a" = "La cámara de cabina graba tu cara con la cámara frontal mientras actúas, para que tu reacción pueda ir en el vídeo. Enciéndela con la tecla de cámara de la parte superior de la ronda o en Ajustes. Las imágenes se quedan en tu dispositivo.";
"help.booth.2.q" = "¿Cómo creo un vídeo?";
"help.booth.2.a" = "En Doblaje de escenas, llega a la última frase y toca Crear vídeo. En Imitación de sonidos, toca Crear vídeo después de una puntuación. Los dos hacen un vídeo vertical para TikTok, Reels or Shorts. Antes de renderizar un doblaje, el juego muestra de quién es la escena, para que conserves el crédito al compartir.";
"help.pro.1.q" = "¿Qué desbloquea Dubloon Pro?";
"help.pro.1.a" = "Tomas ilimitadas en los dos juegos, Doblaje de escenas e Imitación de sonidos. Sin Pro, tus primeras 3 tomas son gratis. Pro es un pago único o una suscripción. Pertenece a este juego: una compra en la app Dubloon no se traspasa.";
"help.troubleshooting.1.q" = "El juego no me oye.";
"help.troubleshooting.1.a" = "Comprueba que el juego puede usar el micrófono: en la app Ajustes, abre Dubloon Game y activa Micrófono. Si otra app está usando el audio, como una llamada, termínala y vuelve a intentarlo.";
"help.troubleshooting.4.q" = "La cámara de cabina no se enciende.";
"help.troubleshooting.4.a" = "El juego necesita la cámara para eso. En la app Ajustes, abre Dubloon Game y activa Cámara.";
