/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "ショーへようこそ！ゲームを選んで、その声を聞かせて。";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "無料テイクを使い切りました！Proにすればステージはあなたのもの。";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "ザ・ゲーム";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "のどを温めて、最高のモノマネを見せて！";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "セリフ %1$d / %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "音を選んでね！";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "シーンを選んでね！";

/* Button after a result: go on to the next sound */
"game.nextSound" = "次の音";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "どちらのゲームもあなたの声を聴く必要があります。シーンを吹き替えるときも、音をまねるときも。マイクが起きるのは録音中だけ。すべてこの端末に残り、どこにもアップロードされません。いちばんひどいテイクは、あなたとこの端末だけの秘密です。";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "準備して…";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "まずは「%@」を聞いて、それから最高のモノマネを！";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "いくよ…準備して！";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "ほらほら！思いっきり！";

/* Said while the take is being judged */
"game.host.scoring" = "うーん、聞き返してみるね…";

/* Reaction to a top score */
"game.host.grade.top" = "すごい！区別がつかない！";

/* Reaction to a good score */
"game.host.grade.good" = "いいね！バッチリ！";

/* Reaction to a near miss */
"game.host.grade.close" = "おしい！もう一回？";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "あはは！大胆だね…もう一回！";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "コツ：音が弾けるところと止まるところをまねしよう。";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "コツ：音の高さの上がり下がりについていこう。";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "コツ：息っぽさやブザーっぽさをまねしよう。";

/* Tip when length was the weakest part */
"game.host.tip.length" = "コツ：元の音と同じ長さにしよう。";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "%@のセリフ！一度見てから、話し始めにぴったり入ろう。";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "出番だよ！ペースを合わせて！";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "コツ：話し始めにぴったり入ろう。";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "コツ：音節のペースに合わせよう。";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "コツ：強いところと弱いところをまねしよう。";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "カット！吹き替えを見てみる？";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "もう吹き替え済み！もう一回か、次へ。";

/* Accessibility label of the trophy on the home stage that opens the Game Center leaderboards */
"game.leaderboards" = "ランキング";

/* Title of the card that explains reminders before iOS asks for notification permission */
"game.reminder.primer.title" = "ショーを見逃さないで";

/* Body of that card: what the reminders are and that they can be turned off in Settings */
"game.reminder.primer.body" = "夕方にチャレンジしたいサウンドと、週間レースの終了前にお知らせします。設定からいつでもオフにできます。";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "続ける";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "ショータイム！";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "今夜のサウンドは「%@」。うまくできるかな？";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "映画のシーンがあなたの声を待っています。ライト、マイク、アクション！";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "ステージは準備OK、観客も盛り上がっています。1ラウンド遊ぼう！";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "週間レース最終日";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "今週は%dポイント。あと1ラウンドで順位が上がるかも！";

/* Settings switch: play fewer of the game's sound effects */
"game.settings.fewerSounds" = "効果音を減らす";

/* Under that switch: what it keeps and what it drops */
"game.settings.fewerSounds.desc" = "タップ音や移動音をオフにします。星やファンファーレは鳴ります。";

/* Under the Sound effects switch: what the game's sounds are */
"game.settings.soundEffects.desc" = "ショーのタップ音、星、ファンファーレ、歓声。";

/* Under Unlock Dubloon Pro in the game's settings: what Pro gives */
"game.settings.unlock.desc" = "最初の3テイクは無料。Dubloon Proならすべてのラウンドが無制限に。";

/* Help, in the game's words. Same keys as the shared Help; the game reads these first. */
"help.gettingStarted.1.q" = "Dubloon the Gameって何？";
"help.gettingStarted.1.a" = "2つのゲームが入った声のゲームショー。映画アフレコ：映画のシーンにセリフごとに声を入れて、採点してもらおう。サウンドモノマネ：音をマネして、最大3つ星を狙おう。司会者がすべてのラウンドを案内します。";
"help.gettingStarted.2.q" = "無料ですか？";
"help.gettingStarted.2.a" = "どちらのゲームも無料で遊べます。最初の3テイクは無料で、2つのゲームを合わせて数えます。そのあとも、すべてのシーンと音は開けて、Dubloon Proなら無制限に録音を続けられます。";
"help.dub.1.q" = "シーンをアフレコするには？";
"help.dub.1.a" = "映画アフレコを開いてシーンを選びます。セリフごとにスピーカーをタップして元の音を聴き、マイクを押します。3拍のカウントのあと録音が始まり、セリフが終わるとマイクは自動で閉じます。矢印でセリフ間を移動できます。";
"help.dub.4.q" = "自分のアフレコを見たり共有したりするには？";
"help.dub.4.a" = "最後のセリフで「自分のアフレコを見る」をタップすると、映画の中で自分のテイクを見られます。「動画を作る」をタップすると、TikTok, Reels or Shorts にぴったりの縦動画ができます。ブースカメラで撮っていれば、その映像がシーンの下に入ります。";
"help.imitate.1.q" = "サウンドモノマネはどう遊ぶ？";
"help.imitate.1.a" = "音を選び、スピーカーをタップして聴いたら、マイクを押して自分で音を出します。司会者がリズム、音の高さ、音色、長さを採点して、最大3つ星を点灯させます。ベストスコアは残るので、また挑戦して超えられます。";
"help.imitate.3.q" = "挑戦を共有できますか？";
"help.imitate.3.a" = "はい。採点のあとに「動画を作る」をタップすると、その音、あなたの挑戦、スコアが入った縦動画ができます。ブースカメラをオンにしていれば、あなたの顔も入ります。";
"help.booth.1.q" = "ブースカメラって何？";
"help.booth.1.a" = "演じている間、フロントカメラであなたの顔を撮影する機能です。リアクションを動画に入れられます。ラウンド上部のカメラキーか設定でオンにします。映像は端末の中に残ります。";
"help.booth.2.q" = "動画はどう作る？";
"help.booth.2.a" = "映画アフレコでは、最後のセリフまで進んで「動画を作る」をタップします。サウンドモノマネでは、採点のあとに「動画を作る」をタップします。どちらも TikTok, Reels or Shorts 向けの縦動画になります。アフレコの書き出し前に、ゲームがそのシーンの出どころを表示するので、共有するときにクレジットを残せます。";
"help.pro.1.q" = "Dubloon Proで何が使える？";
"help.pro.1.a" = "2つのゲーム、映画アフレコとサウンドモノマネでテイク無制限。Proがなくても、最初の3テイクは無料です。Proは買い切りかサブスクリプション。このゲーム専用で、Dubloonアプリでの購入は引き継がれません。";
"help.troubleshooting.1.q" = "ゲームが声を拾ってくれません。";
"help.troubleshooting.1.a" = "ゲームがマイクを使えるか確認してください。「設定」アプリでDubloon Gameを開き、「マイク」をオンにします。通話など、別のアプリがオーディオを使っている場合は、それを終えてからもう一度お試しください。";
"help.troubleshooting.4.q" = "ブースカメラがオンになりません。";
"help.troubleshooting.4.a" = "ブースカメラにはカメラへのアクセスが必要です。「設定」アプリでDubloon Gameを開き、「カメラ」をオンにしてください。";

/* The import gate's third answer, which opens the numbered steps for getting a scene */
"game.dubGate.showSteps" = "手順を見る";
