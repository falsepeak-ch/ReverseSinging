/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "Benvingut al xou! Tria un joc i que se senti aquesta veu.";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "S'han acabat les preses gratuïtes! Fes-te Pro i l'escenari és teu.";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "El Joc";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "Escalfa aquestes cordes vocals i fes la teva millor imitació!";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "Frase %1$d de %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "Tria un so!";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "Tria una escena!";

/* Button after a result: go on to the next sound */
"game.nextSound" = "Següent";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "Els dos jocs necessiten sentir-te: doblant una escena o imitant un so. El micro només es desperta mentre graves, tot es queda en aquest dispositiu i no es puja mai res. La teva pitjor presa es queda entre vosaltres dos.";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "Prepara't…";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "Escolta primer el so: %@. Després fes-me la teva millor imitació!";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "Som-hi… prepara't!";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "Som-hi, som-hi! Sense por!";

/* Said while the take is being judged */
"game.host.scoring" = "Mmm, deixa'm escoltar-ho…";

/* Reaction to a top score */
"game.host.grade.top" = "Increïble! No us distingeixo!";

/* Reaction to a good score */
"game.host.grade.good" = "Molt bé! Ho tens.";

/* Reaction to a near miss */
"game.host.grade.close" = "Gairebé! Un altre cop?";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "Ha! Atrevit… torna-ho a provar!";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "Truc: imita on esclata i on calla.";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "Truc: segueix el to amunt i avall.";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "Truc: copia'n la textura, bufada o vibrant.";

/* Tip when length was the weakest part */
"game.host.tip.length" = "Truc: fes que duri tant com l'original.";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "Frase de %@! Mira-la un cop i entra just quan comenci.";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "Et toca! Segueix-ne el ritme!";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "Truc: entra just quan comença a parlar.";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "Truc: segueix el ritme de les síl·labes.";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "Truc: copia'n els forts i els suaus.";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "I tallem! Vols veure el teu doblatge?";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "Ja està doblada! Repeteix o continua.";

/* Accessibility label of the trophy on the home stage that opens the Game Center leaderboards */
"game.leaderboards" = "Classificacions";

/* Title of the card that explains reminders before iOS asks for notification permission */
"game.reminder.primer.title" = "No et perdis el xou";

/* Body of that card: what the reminders are and that they can be turned off in Settings */
"game.reminder.primer.body" = "T'avisaré al vespre amb un so per provar i abans que acabi la cursa setmanal. Ho pots desactivar a Configuració quan vulguis.";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "Continuar";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "Comença el xou!";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "El so d'aquesta nit és %@. El clavaràs?";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "Una escena t'espera perquè hi posis la veu. Llums, micro, acció!";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "L'escenari és a punt i el públic té ganes. Vine a jugar una ronda!";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "Últim dia de la cursa setmanal";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "Portes %d punts aquesta setmana. Una ronda més et pot fer pujar a la classificació!";
