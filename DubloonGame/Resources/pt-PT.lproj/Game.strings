/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "Bem-vindo ao espetáculo! Escolhe um jogo e mostra-nos essa voz.";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "Acabaram-se as gravações grátis! Passa a Pro e o palco é teu.";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "O Jogo";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "Aquece as cordas vocais e faz a tua melhor imitação!";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "Fala %1$d de %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "Escolhe um som!";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "Escolhe uma cena!";

/* Button after a result: go on to the next sound */
"game.nextSound" = "Seguinte";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "Os dois jogos precisam de te ouvir: a dobrar uma cena ou a imitar um som. O microfone só acorda enquanto gravas, tudo fica neste dispositivo e nada é enviado para lado nenhum. A tua pior gravação fica entre vocês os dois.";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "Prepara-te…";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "Ouve primeiro o som: %@. Depois faz-me a tua melhor imitação!";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "Lá vamos nós… prepara-te!";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "Vai, vai, vai! Sem medo!";

/* Said while the take is being judged */
"game.host.scoring" = "Hmm, deixa-me ouvir outra vez…";

/* Reaction to a top score */
"game.host.grade.top" = "Incrível! Não vos distingo!";

/* Reaction to a good score */
"game.host.grade.good" = "Muito bem! Já está.";

/* Reaction to a near miss */
"game.host.grade.close" = "Quase! Mais uma?";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "Ah! Ousado… tenta outra vez!";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "Dica: imita onde rebenta e onde pára.";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "Dica: segue o tom para cima e para baixo.";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "Dica: copia a textura, soprada ou vibrante.";

/* Tip when length was the weakest part */
"game.host.tip.length" = "Dica: faz durar tanto como o original.";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "Fala de %@! Vê uma vez e entra mesmo quando começa.";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "É a tua vez! Acompanha o ritmo!";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "Dica: entra mesmo quando começa a falar.";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "Dica: acompanha o ritmo das sílabas.";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "Dica: copia os fortes e os suaves.";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "Corta! Queres ver a tua dobragem?";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "Já está dobrada! Repete ou segue em frente.";

/* Accessibility label of the trophy on the home stage that opens the Game Center leaderboards */
"game.leaderboards" = "Classificações";

/* Title of the card that explains reminders before iOS asks for notification permission */
"game.reminder.primer.title" = "Não percas o espetáculo";

/* Body of that card: what the reminders are and that they can be turned off in Settings */
"game.reminder.primer.body" = "Aviso-te ao fim do dia com um som para experimentar e antes de a corrida semanal acabar. Podes desativar isto nas Definições quando quiseres.";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "Continuar";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "Hora do espetáculo!";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "O som desta noite é %@. Consegues acertar?";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "Uma cena de filme espera pela tua voz. Luzes, micro, ação!";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "O palco está pronto e o público está animado. Vem jogar uma ronda!";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "Último dia da corrida semanal";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "Tens %d pontos esta semana. Mais uma ronda pode fazer-te subir na tabela!";

/* Settings switch: play fewer of the game's sound effects */
"game.settings.fewerSounds" = "Menos efeitos sonoros";

/* Under that switch: what it keeps and what it drops */
"game.settings.fewerSounds.desc" = "Sem toques nem deslizes. As estrelas e fanfarras continuam.";

/* Under the Sound effects switch: what the game's sounds are */
"game.settings.soundEffects.desc" = "Toques, estrelas, fanfarras e público do espetáculo.";

/* Under Unlock Dubloon Pro in the game's settings: what Pro gives */
"game.settings.unlock.desc" = "Os teus 3 primeiros takes são grátis. Com o Dubloon Pro, todas as rondas são ilimitadas.";
