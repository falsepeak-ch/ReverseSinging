/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "ยินดีต้อนรับสู่โชว์! เลือกเกมแล้วปล่อยเสียงมาเลย";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "เทคฟรีหมดแล้ว! อัปเกรดเป็น Pro แล้วเวทีเป็นของคุณ";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "เดอะเกม";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "วอร์มเส้นเสียงแล้วเลียนเสียงให้เป๊ะที่สุด!";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "ประโยค %1$d จาก %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "เลือกเสียง!";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "เลือกฉาก!";

/* Button after a result: go on to the next sound */
"game.nextSound" = "เสียงถัดไป";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "ทั้งสองเกมต้องได้ยินคุณ ทั้งตอนพากย์ฉากและตอนเลียนเสียง ไมค์จะตื่นเฉพาะตอนอัด ทุกอย่างอยู่ในเครื่องนี้ และไม่มีอะไรถูกอัปโหลดไปไหน เทคที่แย่ที่สุดของคุณจะรู้กันแค่สองคน";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "เตรียมตัว…";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "ฟังเสียง %@ ก่อน แล้วเลียนเสียงให้เต็มที่!";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "เริ่มแล้วนะ… เตรียมตัว!";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "ลุยเลย! อย่ายั้ง!";

/* Said while the take is being judged */
"game.host.scoring" = "อืม ขอฟังอีกที…";

/* Reaction to a top score */
"game.host.grade.top" = "สุดยอด! แยกไม่ออกเลย!";

/* Reaction to a good score */
"game.host.grade.good" = "เยี่ยม! ทำได้แล้ว";

/* Reaction to a near miss */
"game.host.grade.close" = "เกือบแล้ว! อีกรอบไหม?";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "ฮ่า! กล้ามาก… ลองใหม่นะ!";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "เคล็ดลับ: ตามจังหวะที่เสียงระเบิดและหยุด";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "เคล็ดลับ: ไล่ระดับเสียงขึ้นลงตามต้นฉบับ";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "เคล็ดลับ: เลียนเนื้อเสียง จะลมๆ หรือหึ่งๆ";

/* Tip when length was the weakest part */
"game.host.tip.length" = "เคล็ดลับ: ลากยาวให้เท่าต้นฉบับ";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "บทของ %@! ดูหนึ่งรอบ แล้วเข้าให้ตรงตอนเริ่มพูด";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "ตาคุณแล้ว! ตามจังหวะให้ทัน!";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "เคล็ดลับ: เข้าให้ตรงตอนตัวละครเริ่มพูด";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "เคล็ดลับ: ตามจังหวะพยางค์ให้ทัน";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "เคล็ดลับ: เลียนช่วงดังและช่วงเบา";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "คัท! อยากดูพากย์ของคุณไหม?";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "พากย์แล้ว! อัดใหม่หรือไปต่อ";
