"game.settings.fewerSounds" = "ลดเสียงเอฟเฟกต์";

/* Under that switch: what it keeps and what it drops */
"game.settings.fewerSounds.desc" = "ปิดเสียงแตะและเสียงเปลี่ยนหน้า เสียงดาวและแตรยังดังอยู่";

/* Under the Sound effects switch: what the game's sounds are */
"game.settings.soundEffects.desc" = "เสียงแตะ ดาว แตร และเสียงผู้ชมของโชว์";

/* Under Unlock Dubloon Pro in the game's settings: what Pro gives */
"game.settings.unlock.desc" = "3 เทคแรกฟรี Dubloon Pro ทำให้ทุกรอบไม่จำกัด";
