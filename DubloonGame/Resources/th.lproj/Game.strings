"game.reminder.race.title" = "วันสุดท้ายของการแข่งขันประจำสัปดาห์";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "สัปดาห์นี้คุณมี %d คะแนน อีกรอบเดียวอาจขึ้นอันดับได้!";

