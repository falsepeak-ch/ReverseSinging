/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "Vítej v show! Vyber hru a ukaž, co umí tvůj hlas.";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "Došly ti záběry zdarma! Přejdi na Pro a pódium je tvoje.";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "Hra";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "Rozehřej hlasivky a předveď svou nejlepší imitaci!";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "Replika %1$d z %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "Vyber zvuk!";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "Vyber scénu!";

/* Button after a result: go on to the next sound */
"game.nextSound" = "Další";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "Obě hry tě potřebují slyšet: při dabování scény i při napodobování zvuků. Mikrofon se probouzí jen během nahrávání, všechno zůstává v tomhle zařízení a nikdy se nic nikam neposílá. Tvůj nejhorší pokus zůstane mezi vámi dvěma.";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "Připrav se…";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "Nejdřív si poslechni zvuk: %@. Pak mi předveď svou nejlepší imitaci!";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "Jdeme na to… připrav se!";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "Do toho, do toho! Nestyď se!";

/* Said while the take is being judged */
"game.host.scoring" = "Hmm, poslechnu si to znovu…";

/* Reaction to a top score */
"game.host.grade.top" = "Neuvěřitelné! Nerozeznám vás!";

/* Reaction to a good score */
"game.host.grade.good" = "Paráda! Máš to.";

/* Reaction to a near miss */
"game.host.grade.close" = "Skoro! Ještě jednou?";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "Ha! Odvážné… zkus to znovu!";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "Tip: trefuj, kde zvuk vybuchne a kde se zastaví.";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "Tip: sleduj výšku nahoru a dolů.";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "Tip: napodob barvu, dýchavou nebo bzučivou.";

/* Tip when length was the weakest part */
"game.host.tip.length" = "Tip: ať to trvá stejně dlouho jako originál.";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "Replika postavy %@! Podívej se jednou a nastup přesně na začátek.";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "Jsi na řadě! Drž tempo!";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "Tip: nastup přesně, když postava začne.";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "Tip: drž tempo slabik.";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "Tip: napodob hlasitá a tichá místa.";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "Stop! Chceš vidět svůj dabing?";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "Už nadabováno! Znovu, nebo dál.";

/* Accessibility label of the trophy on the home stage that opens the Game Center leaderboards */
"game.leaderboards" = "Žebříčky";

/* Title of the card that explains reminders before iOS asks for notification permission */
"game.reminder.primer.title" = "Nenech si ujít show";

/* Body of that card: what the reminders are and that they can be turned off in Settings */
"game.reminder.primer.body" = "Večer ti připomenu zvuk na vyzkoušení a také před koncem týdenního závodu. V Nastavení to můžeš kdykoli vypnout.";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "Pokračovat";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "Show začíná!";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "Dnešní zvuk je %@. Zvládneš ho?";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "Filmová scéna čeká na tvůj hlas. Světla, mikrofon, akce!";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "Pódium je připravené a publikum natěšené. Přijď si zahrát kolo!";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "Poslední den týdenního závodu";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "Tento týden máš %d bodů. Ještě jedno kolo tě může posunout výš!";

/* Settings switch: play fewer of the game's sound effects */
"game.settings.fewerSounds" = "Méně zvukových efektů";

/* Under that switch: what it keeps and what it drops */
"game.settings.fewerSounds.desc" = "Bez ťuknutí a švihů. Hvězdy a fanfáry zůstávají.";

/* Under the Sound effects switch: what the game's sounds are */
"game.settings.soundEffects.desc" = "Ťuknutí, hvězdy, fanfáry a publikum show.";

/* Under Unlock Dubloon Pro in the game's settings: what Pro gives */
"game.settings.unlock.desc" = "První 3 pokusy jsou zdarma. S Dubloon Pro je každé kolo neomezené.";

/* Help, in the game's words. Same keys as the shared Help; the game reads these first. */
"help.gettingStarted.1.q" = "Co je Dubloon the Game?";
"help.gettingStarted.1.a" = "Hlasová herní show se dvěma hrami. Dabing filmové scény: namluv filmovou scénu repliku po replice a získej hodnocení. Napodobování zvuků: napodob zvuk a vyhraj až tři hvězdy. Moderátor tě provede každým kolem.";
"help.gettingStarted.2.q" = "Je to zdarma?";
"help.gettingStarted.2.a" = "Obě hry jsou zdarma. Prvních 3 pokusy jsou zdarma, počítají se v obou hrách dohromady. Pak se každá scéna i každý zvuk pořád otevřou a Dubloon Pro ti umožní nahrávat bez omezení.";
"help.dub.1.q" = "Jak nadabuju scénu?";
"help.dub.1.a" = "Otevři Dabing filmové scény a vyber scénu. U každé repliky klepni na reproduktor, abys slyšel originál, a pak stiskni mikrofon: dostaneš tři doby odpočtu a mikrofon se sám zavře, když replika skončí. Mezi replikami se pohybuj šipkami.";
"help.dub.4.q" = "Jak si dabing přehraju nebo sdílím?";
"help.dub.4.a" = "U poslední repliky klepni na Pustit můj dabing a uvidíš své záběry ve filmu. Klepnutím na Vytvořit video získáš svislé video připravené pro TikTok, Reels or Shorts, a pokud jsi natáčel, i se záběry z Booth Cam pod scénou.";
"help.imitate.1.q" = "Jak funguje Napodobování zvuků?";
"help.imitate.1.a" = "Vyber zvuk, klepnutím na reproduktor si ho poslechni, pak stiskni mikrofon a zvuk sám zahraj. Moderátor ohodnotí tvůj rytmus, výšku, barvu a délku a rozsvítí až tři hvězdy. Tvůj nejlepší výsledek se uloží, takže se můžeš vrátit a překonat ho.";
"help.imitate.3.q" = "Můžu sdílet svůj pokus?";
"help.imitate.3.a" = "Ano. Po hodnocení klepni na Vytvořit video: svislé video se zvukem, tvým pokusem a skóre. Když je Booth Cam zapnutá, je v něm i tvůj obličej.";
"help.booth.1.q" = "Co je Booth Cam?";
"help.booth.1.a" = "Booth Cam natáčí tvůj obličej přední kamerou, zatímco hraješ, aby se tvá reakce mohla dostat do videa. Zapneš ji klávesou kamery nahoře v kole nebo v Nastavení. Záběry zůstávají v tvém zařízení.";
"help.booth.2.q" = "Jak vytvořím video?";
"help.booth.2.a" = "V Dabingu filmové scény dojdi k poslední replice a klepni na Vytvořit video. V Napodobování zvuků klepni na Vytvořit video po hodnocení. Obojí vytvoří svislé video pro TikTok, Reels or Shorts. Než se dabing vykreslí, hra ukáže, čí je scéna, abys při sdílení zachoval autora.";
"help.pro.1.q" = "Co odemyká Dubloon Pro?";
"help.pro.1.a" = "Neomezené pokusy v obou hrách, Dabingu filmové scény i Napodobování zvuků. Bez Pro jsou první 3 pokusy zdarma. Pro je jednorázový nákup nebo předplatné. Patří k této hře: nákup v aplikaci Dubloon se sem nepřenáší.";
"help.troubleshooting.1.q" = "Hra mě neslyší.";
"help.troubleshooting.1.a" = "Zkontroluj, že hra smí používat mikrofon: v aplikaci Nastavení otevři Dubloon Game a zapni Mikrofon. Pokud zvuk používá jiná aplikace, třeba hovor, ukonči ji a zkus to znovu.";
"help.troubleshooting.4.q" = "Booth Cam se nezapne.";
"help.troubleshooting.4.a" = "Hra k tomu potřebuje kameru. V aplikaci Nastavení otevři Dubloon Game a zapni Kamera.";

/* The import gate's third answer, which opens the numbered steps for getting a scene */
"game.dubGate.showSteps" = "Ukaž mi to krok za krokem";
