/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "Vítej v show! Vyber hru a ukaž, co umí tvůj hlas.";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "Došly ti záběry zdarma! Přejdi na Pro a pódium je tvoje.";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "Hra";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "Rozehřej hlasivky a předveď svou nejlepší imitaci!";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "Replika %1$d z %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "Vyber zvuk!";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "Vyber scénu!";

/* Button after a result: go on to the next sound */
"game.nextSound" = "Další";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "Obě hry tě potřebují slyšet: při dabování scény i při napodobování zvuků. Mikrofon se probouzí jen během nahrávání, všechno zůstává v tomhle zařízení a nikdy se nic nikam neposílá. Tvůj nejhorší pokus zůstane mezi vámi dvěma.";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "Připrav se…";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "Nejdřív si poslechni zvuk: %@. Pak mi předveď svou nejlepší imitaci!";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "Jdeme na to… připrav se!";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "Do toho, do toho! Nestyď se!";

/* Said while the take is being judged */
"game.host.scoring" = "Hmm, poslechnu si to znovu…";

/* Reaction to a top score */
"game.host.grade.top" = "Neuvěřitelné! Nerozeznám vás!";

/* Reaction to a good score */
"game.host.grade.good" = "Paráda! Máš to.";

/* Reaction to a near miss */
"game.host.grade.close" = "Skoro! Ještě jednou?";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "Ha! Odvážné… zkus to znovu!";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "Tip: trefuj, kde zvuk vybuchne a kde se zastaví.";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "Tip: sleduj výšku nahoru a dolů.";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "Tip: napodob barvu, dýchavou nebo bzučivou.";

/* Tip when length was the weakest part */
"game.host.tip.length" = "Tip: ať to trvá stejně dlouho jako originál.";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "Replika postavy %@! Podívej se jednou a nastup přesně na začátek.";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "Jsi na řadě! Drž tempo!";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "Tip: nastup přesně, když postava začne.";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "Tip: drž tempo slabik.";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "Tip: napodob hlasitá a tichá místa.";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "Stop! Chceš vidět svůj dabing?";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "Už nadabováno! Znovu, nebo dál.";
