/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "Velkommen til showet! Velg et spill og la oss høre stemmen din.";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "Gratisopptakene er brukt opp! Skaff deg Pro, så er scenen din.";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "Spillet";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "Varm opp stemmebåndene og gjør din beste imitasjon!";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "Replikk %1$d av %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "Velg en lyd!";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "Velg en scene!";

/* Button after a result: go on to the next sound */
"game.nextSound" = "Neste";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "Begge spillene må høre deg: dubbing av en scene eller etterligning av en lyd. Mikrofonen våkner bare mens du tar opp, alt blir værende på denne enheten, og ingenting lastes noen gang opp. Det verste opptaket ditt blir mellom dere to.";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "Gjør deg klar …";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "Hør først på lyden: %@. Gi meg så din beste imitasjon!";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "Nå kjører vi … gjør deg klar!";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "Kjør, kjør, kjør! Ikke hold igjen!";

/* Said while the take is being judged */
"game.host.scoring" = "Hmm, la meg høre på nytt …";

/* Reaction to a top score */
"game.host.grade.top" = "Utrolig! Jeg hører ingen forskjell!";

/* Reaction to a good score */
"game.host.grade.good" = "Bra! Du har det.";

/* Reaction to a near miss */
"game.host.grade.close" = "Nesten! En gang til?";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "Ha! Modig … prøv igjen!";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "Tips: treff der det smeller og der det stopper.";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "Tips: følg tonehøyden opp og ned.";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "Tips: etterlign klangen, pustete eller surrete.";

/* Tip when length was the weakest part */
"game.host.tip.length" = "Tips: la det vare like lenge som originalen.";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "%@ har replikken! Se den én gang, og kom inn akkurat når den starter.";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "Din tur! Hold tempoet!";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "Tips: kom inn akkurat når figuren begynner.";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "Tips: hold tempoet i stavelsene.";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "Tips: etterlign det sterke og det svake.";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "Kutt! Vil du se dubbingen din?";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "Allerede dubbet! Igjen eller videre.";

/* Accessibility label of the trophy on the home stage that opens the Game Center leaderboards */
"game.leaderboards" = "Poenglister";

/* Title of the card that explains reminders before iOS asks for notification permission */
"game.reminder.primer.title" = "Ikke gå glipp av showet";

/* Body of that card: what the reminders are and that they can be turned off in Settings */
"game.reminder.primer.body" = "Jeg minner deg på en lyd å prøve om kvelden, og før ukens kappløp er over. Du kan slå det av i Innstillinger når som helst.";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "Fortsett";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "Showtime!";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "Kveldens lyd er %@. Klarer du den?";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "En filmscene venter på stemmen din. Lys, mikrofon, action!";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "Scenen er klar og publikum er varmt. Kom og spill en runde!";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "Siste dag av ukens kappløp";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "Du har %d poeng denne uken. Én runde til kan løfte deg på listen!";

/* Settings switch: play fewer of the game's sound effects */
"game.settings.fewerSounds" = "Færre lydeffekter";

/* Under that switch: what it keeps and what it drops */
"game.settings.fewerSounds.desc" = "Ingen trykk- eller sveipelyder. Stjerner og fanfarer spilles fortsatt.";

/* Under the Sound effects switch: what the game's sounds are */
"game.settings.soundEffects.desc" = "Showets trykk, stjerner, fanfarer og publikum.";

/* Under Unlock Dubloon Pro in the game's settings: what Pro gives */
"game.settings.unlock.desc" = "De første 3 opptakene er gratis. Med Dubloon Pro er hver runde ubegrenset.";

/* Help, in the game's words. Same keys as the shared Help; the game reads these first. */
"help.gettingStarted.1.q" = "Hva er Dubloon the Game?";
"help.gettingStarted.1.a" = "Et stemmespill-show med to spill. Dubb filmscene: legg stemmen din i en filmscene, replikk for replikk, og få en poengsum. Lydimitasjon: etterlign en lyd og vinn opptil tre stjerner. Verten guider deg gjennom hver runde.";
"help.gettingStarted.2.q" = "Er det gratis?";
"help.gettingStarted.2.a" = "Begge spillene er gratis å spille. De første 3 opptakene dine er gratis, talt på tvers av begge spillene. Etterpå kan du fortsatt åpne alle scener og lyder, og Dubloon Pro lar deg ta opp uten grense.";
"help.dub.1.q" = "Hvordan dubber jeg en scene?";
"help.dub.1.a" = "Åpne Dubb filmscene og velg en scene. For hver replikk trykker du på høyttaleren for å høre originalen og så på mikrofonen: du får tre slag inntelling, og mikrofonen lukker seg selv når replikken er ferdig. Bruk pilene for å bytte mellom replikkene.";
"help.dub.4.q" = "Hvordan ser eller deler jeg dubben min?";
"help.dub.4.a" = "På den siste replikken trykker du på Se min dubb for å se opptakene dine i filmen. Trykk på Lag video for en vertikal video klar for TikTok, Reels or Shorts, med Booth Cam-opptakene dine under scenen hvis du har filmet noen.";
"help.imitate.1.q" = "Hvordan fungerer Lydimitasjon?";
"help.imitate.1.a" = "Velg en lyd, trykk på høyttaleren for å høre den, trykk så på mikrofonen og lag lyden selv. Verten vurderer rytme, tonehøyde, klang og lengde og tenner opptil tre stjerner. Den beste poengsummen din lagres, så du kan komme tilbake og slå den.";
"help.imitate.3.q" = "Kan jeg dele et forsøk?";
"help.imitate.3.a" = "Ja. Etter en poengsum trykker du på Lag video: en vertikal video med lyden, forsøket ditt og poengsummen din. Med Booth Cam på er ansiktet ditt også med.";
"help.booth.1.q" = "Hva er Booth Cam?";
"help.booth.1.a" = "Booth Cam filmer ansiktet ditt med frontkameraet mens du spiller, så reaksjonen din kan komme med i videoen. Slå den på med kameraknappen øverst i en runde eller i Innstillinger. Opptakene blir på enheten din.";
"help.booth.2.q" = "Hvordan lager jeg en video?";
"help.booth.2.a" = "I Dubb filmscene kommer du til siste replikk og trykker på Lag video. I Lydimitasjon trykker du på Lag video etter en poengsum. Begge lager en vertikal video for TikTok, Reels or Shorts. Før en dubb gjengis, viser spillet hvem scenen er fra, så du beholder æren når du deler.";
"help.pro.1.q" = "Hva låser Dubloon Pro opp?";
"help.pro.1.a" = "Ubegrensede opptak i begge spillene, Dubb filmscene og Lydimitasjon. Uten Pro er de første 3 opptakene gratis. Pro er et engangskjøp eller et abonnement. Det hører til dette spillet: et kjøp i Dubloon-appen overføres ikke.";
"help.troubleshooting.1.q" = "Spillet hører meg ikke.";
"help.troubleshooting.1.a" = "Sjekk at spillet får bruke mikrofonen: åpne Dubloon Game i Innstillinger-appen og slå på Mikrofon. Hvis en annen app bruker lyden, for eksempel en samtale, avslutt den og prøv igjen.";
"help.troubleshooting.4.q" = "Booth Cam vil ikke slå seg på.";
"help.troubleshooting.4.a" = "Spillet trenger kameraet til det. Åpne Dubloon Game i Innstillinger-appen og slå på Kamera.";
