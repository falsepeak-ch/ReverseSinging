/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "Bienvenue dans le show ! Choisis un jeu et fais-nous entendre ta voix.";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "Tu as utilisé toutes tes prises gratuites ! Passe à Pro et la scène est à toi.";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "Le Jeu";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "Échauffe tes cordes vocales et fais ta meilleure imitation !";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "Réplique %1$d sur %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "Choisis un son !";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "Choisis une scène !";

/* Button after a result: go on to the next sound */
"game.nextSound" = "Son suivant";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "Les deux jeux ont besoin de t'entendre : doubler une scène ou imiter un son. Le micro ne se réveille que pendant l'enregistrement, tout reste sur cet appareil et rien n'est jamais envoyé ailleurs. Ta pire prise restera entre vous deux.";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "Prépare-toi…";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "Écoute d'abord le son : %@. Puis fais-moi ta meilleure imitation !";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "C'est parti… prépare-toi !";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "Vas-y, vas-y ! Lâche-toi !";

/* Said while the take is being judged */
"game.host.scoring" = "Hmm, laisse-moi réécouter…";

/* Reaction to a top score */
"game.host.grade.top" = "Incroyable ! Impossible de vous distinguer !";

/* Reaction to a good score */
"game.host.grade.good" = "Bien joué ! Tu l'as.";

/* Reaction to a near miss */
"game.host.grade.close" = "Presque ! On réessaie ?";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "Ha ! Audacieux… réessaie !";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "Astuce : imite là où ça éclate et là où ça s'arrête.";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "Astuce : suis la hauteur, en haut et en bas.";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "Astuce : copie la texture, soufflée ou vibrante.";

/* Tip when length was the weakest part */
"game.host.tip.length" = "Astuce : fais-le durer autant que l'original.";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "Réplique de %@ ! Regarde-la une fois, puis entre pile au début.";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "À toi ! Garde le rythme !";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "Astuce : entre pile quand le personnage commence.";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "Astuce : suis le rythme des syllabes.";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "Astuce : copie ses forts et ses doux.";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "Coupez ! Tu veux voir ton doublage ?";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "Déjà doublée ! Recommence ou passe à la suite.";

/* Accessibility label of the trophy on the home stage that opens the Game Center leaderboards */
"game.leaderboards" = "Classements";

/* Title of the card that explains reminders before iOS asks for notification permission */
"game.reminder.primer.title" = "Ne manque pas le show";

/* Body of that card: what the reminders are and that they can be turned off in Settings */
"game.reminder.primer.body" = "Je te ferai signe le soir avec un son à tenter, et avant la fin de la course de la semaine. Tu peux désactiver ça dans Réglages à tout moment.";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "Continuer";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "C'est l'heure du show !";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "Le son de ce soir : %@. Tu relèves le défi ?";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "Une scène de film attend ta voix. Lumière, micro, action !";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "La scène est prête et le public est chaud. Viens jouer une manche !";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "Dernier jour de la course de la semaine";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "Tu as %d points cette semaine. Une manche de plus pourrait te faire grimper !";

/* Settings switch: play fewer of the game's sound effects */
"game.settings.fewerSounds" = "Moins d'effets sonores";

/* Under that switch: what it keeps and what it drops */
"game.settings.fewerSounds.desc" = "Plus de clics ni de swoosh. Les étoiles et fanfares restent.";

/* Under the Sound effects switch: what the game's sounds are */
"game.settings.soundEffects.desc" = "Clics, étoiles, fanfares et public du show.";

/* Under Unlock Dubloon Pro in the game's settings: what Pro gives */
"game.settings.unlock.desc" = "Tes 3 premières prises sont gratuites. Avec Dubloon Pro, chaque manche est illimitée.";

/* Help, in the game's words. Same keys as the shared Help; the game reads these first. */
"help.gettingStarted.1.q" = "Qu'est-ce que Dubloon the Game ?";
"help.gettingStarted.1.a" = "Un jeu télévisé de voix avec deux jeux. Doublage de scène : mets ta voix dans une scène de film, réplique par réplique, et reçois une note. Imitation de sons : imite un son et gagne jusqu'à trois étoiles. L'animateur te guide à chaque manche.";
"help.gettingStarted.2.q" = "Est-ce gratuit ?";
"help.gettingStarted.2.a" = "Les deux jeux sont gratuits. Tes 3 premières prises sont gratuites, comptées sur les deux jeux. Ensuite, chaque scène et chaque son restent ouverts, et Dubloon Pro te laisse enregistrer sans limite.";
"help.dub.1.q" = "Comment doubler une scène ?";
"help.dub.1.a" = "Ouvre Doublage de scène et choisis une scène. Pour chaque réplique, touche le haut-parleur pour entendre l'original, puis appuie sur le micro : tu as trois temps de décompte, et le micro se coupe tout seul à la fin de la réplique. Utilise les flèches pour passer d'une réplique à l'autre.";
"help.dub.4.q" = "Comment voir ou partager mon doublage ?";
"help.dub.4.a" = "À la dernière réplique, touche Voir mon doublage pour voir tes prises dans le film. Touche Créer la vidéo pour obtenir une vidéo verticale prête pour TikTok, Reels or Shorts, avec tes images de la caméra de cabine sous la scène si tu en as filmé.";
"help.imitate.1.q" = "Comment marche l'Imitation de sons ?";
"help.imitate.1.a" = "Choisis un son, touche le haut-parleur pour l'entendre, puis appuie sur le micro et fais le son toi-même. L'animateur note ton rythme, ta hauteur, ton timbre et ta durée, et allume jusqu'à trois étoiles. Ton meilleur score est gardé, tu peux donc revenir le battre.";
"help.imitate.3.q" = "Puis-je partager un essai ?";
"help.imitate.3.a" = "Oui. Après une note, touche Créer la vidéo : une vidéo verticale avec le son, ton essai et ta note. Avec la caméra de cabine activée, ton visage y est aussi.";
"help.booth.1.q" = "Qu'est-ce que la caméra de cabine ?";
"help.booth.1.a" = "La caméra de cabine filme ton visage avec la caméra avant pendant que tu joues, pour que ta réaction puisse aller dans la vidéo. Active-la avec la touche caméra en haut d'une manche, ou dans les Réglages. Les images restent sur ton appareil.";
"help.booth.2.q" = "Comment créer une vidéo ?";
"help.booth.2.a" = "Dans Doublage de scène, va à la dernière réplique et touche Créer la vidéo. Dans Imitation de sons, touche Créer la vidéo après une note. Les deux font une vidéo verticale pour TikTok, Reels or Shorts. Avant le rendu d'un doublage, le jeu indique à qui appartient la scène, pour que tu gardes le crédit en partageant.";
"help.pro.1.q" = "Que débloque Dubloon Pro ?";
"help.pro.1.a" = "Des prises illimitées dans les deux jeux, Doublage de scène et Imitation de sons. Sans Pro, tes 3 premières prises sont gratuites. Pro est un achat unique ou un abonnement. Il appartient à ce jeu : un achat dans l'app Dubloon ne se transfère pas.";
"help.troubleshooting.1.q" = "Le jeu ne m'entend pas.";
"help.troubleshooting.1.a" = "Vérifie que le jeu peut utiliser le micro : dans l'app Réglages, ouvre Dubloon Game et active Micro. Si une autre app utilise l'audio, comme un appel, termine-le et réessaie.";
"help.troubleshooting.4.q" = "La caméra de cabine ne s'active pas.";
"help.troubleshooting.4.a" = "Le jeu a besoin de l'appareil photo pour ça. Dans l'app Réglages, ouvre Dubloon Game et active Appareil photo.";
