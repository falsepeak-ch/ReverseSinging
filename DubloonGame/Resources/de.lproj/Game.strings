/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "Willkommen in der Show! Wähl ein Spiel und lass deine Stimme hören.";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "Deine Gratis-Takes sind aufgebraucht! Hol dir Pro, und die Bühne gehört dir.";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "Das Spiel";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "Wärm deine Stimmbänder auf und gib deine beste Imitation!";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "Satz %1$d von %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "Wähl einen Sound!";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "Wähl eine Szene!";

/* Button after a result: go on to the next sound */
"game.nextSound" = "Nächster";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "Beide Spiele müssen dich hören: eine Szene synchronisieren oder ein Geräusch nachmachen. Das Mikro wacht nur während der Aufnahme auf, alles bleibt auf diesem Gerät und nichts wird jemals hochgeladen. Deine schlimmste Aufnahme bleibt unter euch beiden.";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "Mach dich bereit …";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "Hör dir zuerst das Geräusch an: %@. Dann gib mir deine beste Imitation!";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "Los geht's … mach dich bereit!";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "Los, los, los! Gib alles!";

/* Said while the take is being judged */
"game.host.scoring" = "Hmm, ich hör's mir noch mal an …";

/* Reaction to a top score */
"game.host.grade.top" = "Unglaublich! Ich kann euch nicht unterscheiden!";

/* Reaction to a good score */
"game.host.grade.good" = "Stark! Du hast es drauf.";

/* Reaction to a near miss */
"game.host.grade.close" = "Knapp! Noch ein Versuch?";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "Ha! Mutig … versuch's noch mal!";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "Tipp: Triff, wo es loslegt und wo es pausiert.";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "Tipp: Folge der Tonhöhe rauf und runter.";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "Tipp: Kopier den Klang, hauchig oder brummig.";

/* Tip when length was the weakest part */
"game.host.tip.length" = "Tipp: Lass es so lange dauern wie das Original.";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "%@ ist dran! Schau's dir einmal an und setz genau beim Start ein.";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "Du bist dran! Halt das Tempo!";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "Tipp: Setz genau ein, wenn die Figur anfängt.";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "Tipp: Halt das Tempo der Silben.";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "Tipp: Kopier das Laute und das Leise.";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "Und Schnitt! Willst du deine Synchro sehen?";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "Schon synchronisiert! Noch mal oder weiter.";

/* Accessibility label of the trophy on the home stage that opens the Game Center leaderboards */
"game.leaderboards" = "Bestenlisten";

/* Title of the card that explains reminders before iOS asks for notification permission */
"game.reminder.primer.title" = "Verpass die Show nicht";

/* Body of that card: what the reminders are and that they can be turned off in Settings */
"game.reminder.primer.body" = "Ich erinnere dich abends an einen neuen Sound und bevor das Wochenrennen endet. Du kannst das jederzeit in den Einstellungen ausschalten.";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "Weiter";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "Showtime!";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "Der Sound des Abends: %@. Schaffst du ihn?";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "Eine Filmszene wartet auf deine Stimme. Licht, Mikro, Action!";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "Die Bühne steht, das Publikum ist bereit. Spiel eine Runde!";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "Letzter Tag des Wochenrennens";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "Du hast diese Woche %d Punkte. Eine Runde mehr kann dich nach oben bringen!";

/* Settings switch: play fewer of the game's sound effects */
"game.settings.fewerSounds" = "Weniger Soundeffekte";

/* Under that switch: what it keeps and what it drops */
"game.settings.fewerSounds.desc" = "Keine Tipp- und Wischgeräusche. Sterne und Fanfaren bleiben.";

/* Under the Sound effects switch: what the game's sounds are */
"game.settings.soundEffects.desc" = "Klicks, Sterne, Fanfaren und Publikum der Show.";

/* Under Unlock Dubloon Pro in the game's settings: what Pro gives */
"game.settings.unlock.desc" = "Deine ersten 3 Takes sind gratis. Mit Dubloon Pro ist jede Runde unbegrenzt.";

/* Help, in the game's words. Same keys as the shared Help; the game reads these first. */
"help.gettingStarted.1.q" = "Was ist Dubloon the Game?";
"help.gettingStarted.1.a" = "Eine Stimm-Gameshow mit zwei Spielen. Filmszene synchronisieren: Leg deine Stimme Zeile für Zeile in eine Filmszene und lass dich bewerten. Geräusche imitieren: Mach ein Geräusch nach und gewinn bis zu drei Sterne. Der Moderator führt dich durch jede Runde.";
"help.gettingStarted.2.q" = "Ist es kostenlos?";
"help.gettingStarted.2.a" = "Beide Spiele sind kostenlos spielbar. Deine ersten 3 Takes sind gratis, gezählt über beide Spiele hinweg. Danach lässt sich weiterhin jede Szene und jedes Geräusch öffnen, und mit Dubloon Pro nimmst du ohne Limit weiter auf.";
"help.dub.1.q" = "Wie synchronisiere ich eine Szene?";
"help.dub.1.a" = "Öffne Filmszene synchronisieren und wähl eine Szene. Tipp bei jeder Zeile auf den Lautsprecher, um das Original zu hören, und drück dann auf das Mikro: Du bekommst drei Schläge Vorzählen, und das Mikro schließt sich von selbst, wenn die Zeile endet. Mit den Pfeilen wechselst du zwischen den Zeilen.";
"help.dub.4.q" = "Wie sehe ich meine Fassung an oder teile sie?";
"help.dub.4.a" = "Tipp bei der letzten Zeile auf Meine Fassung ansehen, um deine Takes im Film zu sehen. Tipp auf Video erstellen für ein Hochformat-Video, bereit für TikTok, Reels or Shorts, mit deinen Booth-Cam-Aufnahmen unter der Szene, falls du welche gefilmt hast.";
"help.imitate.1.q" = "Wie funktioniert Geräusche imitieren?";
"help.imitate.1.a" = "Wähl ein Geräusch, tipp auf den Lautsprecher, um es zu hören, drück dann auf das Mikro und mach das Geräusch selbst. Der Moderator bewertet Rhythmus, Tonhöhe, Klang und Länge und lässt bis zu drei Sterne aufleuchten. Dein Bestwert wird gespeichert, du kannst also wiederkommen und ihn übertreffen.";
"help.imitate.3.q" = "Kann ich einen Versuch teilen?";
"help.imitate.3.a" = "Ja. Tipp nach einer Wertung auf Video erstellen: ein Hochformat-Video mit dem Geräusch, deinem Versuch und deiner Wertung. Mit eingeschalteter Booth Cam ist auch dein Gesicht dabei.";
"help.booth.1.q" = "Was ist Booth Cam?";
"help.booth.1.a" = "Booth Cam filmt dein Gesicht mit der Frontkamera, während du spielst, damit deine Reaktion ins Video kann. Schalt sie mit der Kamerataste oben in einer Runde oder in den Einstellungen ein. Die Aufnahmen bleiben auf deinem Gerät.";
"help.booth.2.q" = "Wie erstelle ich ein Video?";
"help.booth.2.a" = "Geh in Filmszene synchronisieren zur letzten Zeile und tipp auf Video erstellen. Tipp in Geräusche imitieren nach einer Wertung auf Video erstellen. Beides ergibt ein Hochformat-Video für TikTok, Reels or Shorts. Bevor eine Fassung gerendert wird, zeigt das Spiel, wessen Szene es ist, damit du beim Teilen den Credit behältst.";
"help.pro.1.q" = "Was schaltet Dubloon Pro frei?";
"help.pro.1.a" = "Unbegrenzte Takes in beiden Spielen, Filmszene synchronisieren und Geräusche imitieren. Ohne Pro sind deine ersten 3 Takes kostenlos. Pro gibt es als Einmalkauf oder als Abo. Es gehört zu diesem Spiel: Ein Kauf in der Dubloon-App wird nicht übernommen.";
"help.troubleshooting.1.q" = "Das Spiel hört mich nicht.";
"help.troubleshooting.1.a" = "Prüf, ob das Spiel das Mikrofon benutzen darf: Öffne in der Einstellungen-App Dubloon Game und schalt Mikrofon ein. Nutzt eine andere App gerade das Audio, etwa ein Anruf, beende sie und versuch es noch mal.";
"help.troubleshooting.4.q" = "Booth Cam lässt sich nicht einschalten.";
"help.troubleshooting.4.a" = "Dafür braucht das Spiel die Kamera. Öffne in der Einstellungen-App Dubloon Game und schalt Kamera ein.";

/* The import gate's third answer, which opens the numbered steps for getting a scene */
"game.dubGate.showSteps" = "Zeig's mir Schritt für Schritt";
