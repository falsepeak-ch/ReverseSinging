/* Help, in the game's words. Same keys as the shared Help; the game reads these first. */
"help.gettingStarted.1.q" = "Що таке Dubloon the Game?";
"help.gettingStarted.1.a" = "Голосове ігрове шоу з двома іграми. «Озвучення сцени»: озвуч сцену з фільму репліку за реплікою й отримай оцінку. «Імітація звуків»: наслідуй звук і здобудь до трьох зірок. Ведучий проведе тебе крізь кожен раунд.";
"help.gettingStarted.2.q" = "Це безкоштовно?";
"help.gettingStarted.2.a" = "Обидві гри безкоштовні. Перші 3 дублі безкоштовні, вони рахуються одразу по обох іграх. Після цього кожна сцена й кожен звук усе одно відкриваються, а Dubloon Pro дозволяє записувати без обмежень.";
"help.dub.1.q" = "Як озвучити сцену?";
"help.dub.1.a" = "Відкрий «Озвучення сцени» й обери сцену. Для кожної репліки натисни на динамік, щоб почути оригінал, потім натисни мікрофон: буде три удари відліку, а мікрофон сам закриється, коли репліка закінчиться. Стрілками переходь між репліками.";
"help.dub.4.q" = "Як переглянути своє озвучення або поділитися ним?";
"help.dub.4.a" = "На останній репліці натисни «Дивитися моє озвучення», щоб побачити свої дублі у фільмі. Натисни «Зробити відео», щоб отримати вертикальне відео для TikTok, Reels or Shorts, а якщо ти знімав, то з кадрами Booth Cam під сценою.";
"help.imitate.1.q" = "Як працює «Імітація звуків»?";
"help.imitate.1.a" = "Обери звук, натисни на динамік, щоб його почути, потім натисни мікрофон і відтвори звук сам. Ведучий оцінює твій ритм, висоту, тембр і тривалість та запалює до трьох зірок. Найкращий результат зберігається, тож можна повернутися й побити його.";
"help.imitate.3.q" = "Чи можна поділитися спробою?";
"help.imitate.3.a" = "Так. Після оцінки натисни «Зробити відео»: вертикальне відео зі звуком, твоєю спробою й оцінкою. Якщо Booth Cam увімкнено, у ньому буде й твоє обличчя.";
"help.booth.1.q" = "Що таке Booth Cam?";
"help.booth.1.a" = "Booth Cam знімає твоє обличчя фронтальною камерою, поки ти граєш, щоб твоя реакція потрапила у відео. Увімкни її клавішею камери у верхній частині раунду або в Налаштуваннях. Кадри залишаються на твоєму пристрої.";
"help.booth.2.q" = "Як зробити відео?";
"help.booth.2.a" = "В «Озвученні сцени» дійди до останньої репліки й натисни «Зробити відео». В «Імітації звуків» натисни «Зробити відео» після оцінки. В обох випадках вийде вертикальне відео для TikTok, Reels or Shorts. Перед рендером озвучення гра показує, чия це сцена, щоб ти зберіг авторство, коли ділишся.";
"help.pro.1.q" = "Що відкриває Dubloon Pro?";
"help.pro.1.a" = "Безлімітні дублі в обох іграх, «Озвученні сцени» та «Імітації звуків». Без Pro перші 3 дублі безкоштовні. Pro — це разова покупка або підписка. Він належить цій грі: покупка в застосунку Dubloon не переноситься.";
"help.troubleshooting.1.q" = "Гра мене не чує.";
"help.troubleshooting.1.a" = "Перевір, що грі можна користуватися мікрофоном: у застосунку Налаштування відкрий Dubloon Game і ввімкни «Мікрофон». Якщо звук зайнятий іншою програмою, наприклад дзвінком, заверши його й спробуй знову.";
"help.troubleshooting.4.q" = "Booth Cam не вмикається.";
"help.troubleshooting.4.a" = "Для неї грі потрібна камера. У застосунку Налаштування відкрий Dubloon Game і ввімкни «Камера».";
