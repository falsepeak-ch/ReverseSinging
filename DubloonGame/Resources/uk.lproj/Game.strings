/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "Ласкаво просимо на шоу! Обери гру й покажи свій голос.";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "Безплатні дублі закінчилися! Оформи Pro — і сцена твоя.";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "Гра";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "Розігрій голосові зв'язки й покажи найкращу пародію!";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "Репліка %1$d з %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "Обери звук!";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "Обери сцену!";

/* Button after a result: go on to the next sound */
"game.nextSound" = "Наступний";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "Обом іграм треба тебе чути: і озвученню сцени, і наслідуванню звуків. Мікрофон прокидається лише під час запису, усе лишається на цьому пристрої й нікуди не надсилається. Твій найгірший дубль лишиться між вами двома.";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "Приготуйся…";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "Спершу послухай звук: %@. А потім покажи найкращу пародію!";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "Поїхали… приготуйся!";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "Давай, давай! Не соромся!";

/* Said while the take is being judged */
"game.host.scoring" = "Хм, дай-но переслухаю…";

/* Reaction to a top score */
"game.host.grade.top" = "Неймовірно! Вас не розрізнити!";

/* Reaction to a good score */
"game.host.grade.good" = "Чудово! У тебе виходить.";

/* Reaction to a near miss */
"game.host.grade.close" = "Майже! Ще разок?";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "Ха! Сміливо… спробуй ще!";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "Порада: повторюй, де звук вибухає і де замовкає.";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "Порада: стеж за висотою вгору й униз.";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "Порада: передай тембр — з придихом чи з дзижчанням.";

/* Tip when length was the weakest part */
"game.host.tip.length" = "Порада: тягни стільки ж, скільки оригінал.";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "Репліка: %@! Подивись раз і вступай рівно на початку.";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "Твій вихід! Тримай темп!";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "Порада: вступай рівно, коли персонаж починає.";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "Порада: тримай темп складів.";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "Порада: повторюй гучні й тихі місця.";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "Знято! Подивишся свою озвучку?";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "Уже озвучено! Ще раз чи далі.";

/* Accessibility label of the trophy on the home stage that opens the Game Center leaderboards */
"game.leaderboards" = "Таблиці лідерів";

/* Title of the card that explains reminders before iOS asks for notification permission */
"game.reminder.primer.title" = "Не пропусти шоу";

/* Body of that card: what the reminders are and that they can be turned off in Settings */
"game.reminder.primer.body" = "Увечері я нагадаю про звук, який варто спробувати, і про кінець тижневих перегонів. Це можна вимкнути в Параметрах будь-коли.";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "Продовжити";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "Час шоу!";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "Звук цього вечора: %@. Зможеш повторити?";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "Сцена з фільму чекає на твій голос. Світло, мікрофон, мотор!";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "Сцена готова, зала розігріта. Зіграй раунд!";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "Останній день тижневих перегонів";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "У тебе %d балів цього тижня. Ще один раунд може підняти тебе вище!";

/* Settings switch: play fewer of the game's sound effects */
"game.settings.fewerSounds" = "Менше звукових ефектів";

/* Under that switch: what it keeps and what it drops */
"game.settings.fewerSounds.desc" = "Без клацань і свистів. Зірки й фанфари залишаються.";

/* Under the Sound effects switch: what the game's sounds are */
"game.settings.soundEffects.desc" = "Клацання, зірки, фанфари й глядачі шоу.";

/* Under Unlock Dubloon Pro in the game's settings: what Pro gives */
"game.settings.unlock.desc" = "Перші 3 дублі безкоштовні. З Dubloon Pro кожен раунд без обмежень.";
