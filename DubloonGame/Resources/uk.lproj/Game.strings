"game.reminder.primer.body" = "Увечері я нагадаю про звук, який варто спробувати, і про кінець тижневих перегонів. Це можна вимкнути в Параметрах будь-коли.";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "Продовжити";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "Час шоу!";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "Звук цього вечора: %@. Зможеш повторити?";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "Сцена з фільму чекає на твій голос. Світло, мікрофон, мотор!";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "Сцена готова, зала розігріта. Зіграй раунд!";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "Останній день тижневих перегонів";

