/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "Benvenuto allo show! Scegli un gioco e facci sentire la tua voce.";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "Hai finito le registrazioni gratuite! Passa a Pro e il palco è tuo.";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "Il Gioco";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "Scalda le corde vocali e fai la tua imitazione migliore!";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "Battuta %1$d di %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "Scegli un suono!";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "Scegli una scena!";

/* Button after a result: go on to the next sound */
"game.nextSound" = "Prossimo";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "Entrambi i giochi devono sentirti: doppiare una scena o imitare un suono. Il microfono si sveglia solo mentre registri, tutto resta su questo dispositivo e non viene mai caricato niente. La tua take peggiore resta tra voi due.";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "Preparati…";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "Ascolta prima il suono: %@. Poi fammi la tua imitazione migliore!";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "Ci siamo… preparati!";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "Vai vai vai! Senza paura!";

/* Said while the take is being judged */
"game.host.scoring" = "Mmm, fammi riascoltare…";

/* Reaction to a top score */
"game.host.grade.top" = "Incredibile! Non vi distinguo!";

/* Reaction to a good score */
"game.host.grade.good" = "Bravo! Ce l'hai.";

/* Reaction to a near miss */
"game.host.grade.close" = "Quasi! Un altro tentativo?";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "Ah! Scelta audace… riprova!";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "Consiglio: imita dove esplode e dove si ferma.";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "Consiglio: segui il tono su e giù.";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "Consiglio: copia la consistenza, soffiata o ronzante.";

/* Tip when length was the weakest part */
"game.host.tip.length" = "Consiglio: fallo durare quanto l'originale.";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "Battuta di %@! Guardala una volta, poi entra appena inizia.";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "Tocca a te! Tieni il ritmo!";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "Consiglio: entra appena inizia a parlare.";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "Consiglio: segui il ritmo delle sillabe.";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "Consiglio: copia forti e piani.";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "Stop! Vuoi vedere il tuo doppiaggio?";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "Già doppiata! Rifalla o vai avanti.";

/* Accessibility label of the trophy on the home stage that opens the Game Center leaderboards */
"game.leaderboards" = "Classifiche";

/* Title of the card that explains reminders before iOS asks for notification permission */
"game.reminder.primer.title" = "Non perderti lo show";

/* Body of that card: what the reminders are and that they can be turned off in Settings */
"game.reminder.primer.body" = "Ti avviserò la sera con un suono da provare e prima che finisca la gara settimanale. Puoi disattivarlo in Impostazioni quando vuoi.";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "Continua";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "Si va in onda!";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "Il suono di stasera è %@. Riesci a farlo?";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "Una scena di film aspetta la tua voce. Luci, microfono, azione!";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "Il palco è pronto e il pubblico è caldo. Vieni a fare un round!";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "Ultimo giorno della gara settimanale";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "Hai %d punti questa settimana. Un altro round potrebbe farti salire in classifica!";

/* Settings switch: play fewer of the game's sound effects */
"game.settings.fewerSounds" = "Meno effetti sonori";

/* Under that switch: what it keeps and what it drops */
"game.settings.fewerSounds.desc" = "Niente tocchi né fruscii. Stelle e fanfare restano.";

/* Under the Sound effects switch: what the game's sounds are */
"game.settings.soundEffects.desc" = "Tocchi, stelle, fanfare e pubblico dello show.";

/* Under Unlock Dubloon Pro in the game's settings: what Pro gives */
"game.settings.unlock.desc" = "Le prime 3 take sono gratis. Con Dubloon Pro ogni round è illimitato.";

/* Help, in the game's words. Same keys as the shared Help; the game reads these first. */
"help.gettingStarted.1.q" = "Che cos'è Dubloon the Game?";
"help.gettingStarted.1.a" = "Un quiz show di voce con due giochi. Doppiaggio di scene: metti la tua voce in una scena di film, battuta per battuta, e ricevi un punteggio. Imitazione di suoni: imita un suono e vinci fino a tre stelle. Il presentatore ti accompagna in ogni round.";
"help.gettingStarted.2.q" = "È gratis?";
"help.gettingStarted.2.a" = "Entrambi i giochi sono gratuiti. Le tue prime 3 take sono gratis, contate su entrambi i giochi. Dopo, ogni scena e ogni suono si aprono comunque, e Dubloon Pro ti lascia registrare senza limiti.";
"help.dub.1.q" = "Come doppio una scena?";
"help.dub.1.a" = "Apri Doppiaggio di scene e scegli una scena. Per ogni battuta, tocca l'altoparlante per sentire l'originale e poi premi il microfono: hai tre battiti di conto alla rovescia, e il microfono si chiude da solo quando la battuta finisce. Usa le frecce per spostarti tra le battute.";
"help.dub.4.q" = "Come guardo o condivido il mio doppiaggio?";
"help.dub.4.a" = "All'ultima battuta, tocca Guarda il mio doppiaggio per vedere le tue take nel film. Tocca Crea video per un video verticale pronto per TikTok, Reels or Shorts, con il girato di Booth Cam sotto la scena se ne hai ripreso.";
"help.imitate.1.q" = "Come funziona l'Imitazione di suoni?";
"help.imitate.1.a" = "Scegli un suono, tocca l'altoparlante per ascoltarlo, poi premi il microfono e fai tu il suono. Il presentatore valuta ritmo, intonazione, timbro e durata e accende fino a tre stelle. Il tuo punteggio migliore viene salvato, così puoi tornare a batterlo.";
"help.imitate.3.q" = "Posso condividere un tentativo?";
"help.imitate.3.a" = "Sì. Dopo un punteggio, tocca Crea video: un video verticale con il suono, il tuo tentativo e il tuo punteggio. Con Booth Cam accesa, c'è anche la tua faccia.";
"help.booth.1.q" = "Che cos'è Booth Cam?";
"help.booth.1.a" = "Booth Cam riprende la tua faccia con la fotocamera frontale mentre reciti, così la tua reazione può finire nel video. Accendila con il tasto fotocamera in alto in un round o nelle Impostazioni. Il girato resta sul tuo dispositivo.";
"help.booth.2.q" = "Come creo un video?";
"help.booth.2.a" = "In Doppiaggio di scene, arriva all'ultima battuta e tocca Crea video. In Imitazione di suoni, tocca Crea video dopo un punteggio. Entrambi fanno un video verticale per TikTok, Reels or Shorts. Prima di elaborare un doppiaggio, il gioco mostra di chi è la scena, così mantieni i crediti quando condividi.";
"help.pro.1.q" = "Cosa sblocca Dubloon Pro?";
"help.pro.1.a" = "Take illimitate in entrambi i giochi, Doppiaggio di scene e Imitazione di suoni. Senza Pro, le tue prime 3 take sono gratis. Pro è un acquisto unico o un abbonamento. Appartiene a questo gioco: un acquisto nell'app Dubloon non si trasferisce.";
"help.troubleshooting.1.q" = "Il gioco non mi sente.";
"help.troubleshooting.1.a" = "Controlla che il gioco possa usare il microfono: nell'app Impostazioni, apri Dubloon Game e attiva Microfono. Se un'altra app sta usando l'audio, come una chiamata, chiudila e riprova.";
"help.troubleshooting.4.q" = "Booth Cam non si accende.";
"help.troubleshooting.4.a" = "Il gioco ha bisogno della fotocamera per questo. Nell'app Impostazioni, apri Dubloon Game e attiva Fotocamera.";
