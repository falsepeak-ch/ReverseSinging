/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "Welcome to the show! Pick a game and let's hear that voice.";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "That's all your free takes! Go Pro and the stage is yours.";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "The Game";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "Warm up those vocal cords and do your best impression!";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "Line %1$d of %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "Pick a sound!";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "Pick a scene!";

/* Button after a result: go on to the next sound */
"game.nextSound" = "Next sound";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "Both games need to hear you: dubbing a scene or copying a sound. The mic wakes up only while you record, everything stays on this device, and nothing is ever uploaded. Your worst take stays between the two of you.";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "Get ready…";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "Listen to the %@ first, then give me your best impression!";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "Here we go… get ready!";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "Go go go! Don't hold back!";

/* Said while the take is being judged */
"game.host.scoring" = "Hmm, let me listen back…";

/* Reaction to a top score */
"game.host.grade.top" = "Incredible! I couldn't tell you apart!";

/* Reaction to a good score */
"game.host.grade.good" = "Nice one! You've really got it.";

/* Reaction to a near miss */
"game.host.grade.close" = "So close! One more go?";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "Ha! Bold choice… try again!";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "Tip: match where it bursts and where it pauses.";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "Tip: follow its pitch up and down.";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "Tip: copy its texture, breathy or buzzy.";

/* Tip when length was the weakest part */
"game.host.tip.length" = "Tip: make it last as long as the original.";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "%@'s line! Watch it once, then come in right as they start.";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "You're on! Keep pace with them!";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "Tip: come in right when they start talking.";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "Tip: keep pace with their syllables.";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "Tip: copy their louds and softs.";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "That's a wrap! Want to watch your dub?";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "Already dubbed! Go again or move on.";

/* Accessibility label of the trophy on the home stage that opens the Game Center leaderboards */
"game.leaderboards" = "Leaderboards";

/* Title of the card that explains reminders before iOS asks for notification permission */
"game.reminder.primer.title" = "Never miss the show";

/* Body of that card: what the reminders are and that they can be turned off in Settings */
"game.reminder.primer.body" = "I'll nudge you in the evening with a sound to try, and before the weekly race ends. You can turn this off in Settings any time.";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "Continue";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "Showtime!";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "Tonight's sound is %@. Can you nail it?";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "A movie scene is waiting for your voice. Lights, mic, action!";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "The stage is set and the crowd is warm. Come play a round!";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "Last day of the weekly race";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "You're on %d points this week. One more round could move you up the board!";
