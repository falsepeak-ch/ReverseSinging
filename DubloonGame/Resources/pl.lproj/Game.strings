/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "Witaj w show! Wybierz grę i pokaż, co potrafi twój głos.";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "Darmowe nagrania się skończyły! Przejdź na Pro, a scena jest twoja.";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "Gra";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "Rozgrzej struny głosowe i daj z siebie najlepszą imitację!";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "Kwestia %1$d z %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "Wybierz dźwięk!";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "Wybierz scenę!";

/* Button after a result: go on to the next sound */
"game.nextSound" = "Następny";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "Obie gry muszą cię słyszeć: przy dubbingu sceny i naśladowaniu dźwięków. Mikrofon budzi się tylko na czas nagrania, wszystko zostaje na tym urządzeniu i nic nigdy nigdzie nie wędruje. Twoje najgorsze podejście zostanie między wami.";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "Przygotuj się…";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "Najpierw posłuchaj dźwięku: %@. Potem daj z siebie najlepszą imitację!";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "Zaczynamy… przygotuj się!";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "Dawaj, dawaj! Nie krępuj się!";

/* Said while the take is being judged */
"game.host.scoring" = "Hmm, posłucham jeszcze raz…";

/* Reaction to a top score */
"game.host.grade.top" = "Niesamowite! Nie odróżniam was!";

/* Reaction to a good score */
"game.host.grade.good" = "Brawo! Masz to.";

/* Reaction to a near miss */
"game.host.grade.close" = "Prawie! Jeszcze raz?";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "Ha! Odważnie… spróbuj jeszcze raz!";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "Wskazówka: trafiaj w wybuchy i pauzy.";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "Wskazówka: podążaj za wysokością w górę i w dół.";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "Wskazówka: skopiuj barwę, chuchającą albo brzęczącą.";

/* Tip when length was the weakest part */
"game.host.tip.length" = "Wskazówka: niech trwa tak długo jak oryginał.";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "Kwestia postaci %@! Obejrzyj raz i wejdź dokładnie na start.";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "Twoja kolej! Trzymaj tempo!";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "Wskazówka: wejdź dokładnie, gdy postać zaczyna.";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "Wskazówka: trzymaj tempo sylab.";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "Wskazówka: skopiuj głośne i ciche fragmenty.";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "Cięcie! Chcesz obejrzeć swój dubbing?";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "Już nagrane! Jeszcze raz albo dalej.";

/* Accessibility label of the trophy on the home stage that opens the Game Center leaderboards */
"game.leaderboards" = "Rankingi";

/* Title of the card that explains reminders before iOS asks for notification permission */
"game.reminder.primer.title" = "Nie przegap show";

/* Body of that card: what the reminders are and that they can be turned off in Settings */
"game.reminder.primer.body" = "Wieczorem przypomnę ci o dźwięku do spróbowania i przed końcem tygodniowego wyścigu. Możesz to wyłączyć w Ustawieniach w dowolnej chwili.";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "Dalej";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "Czas na show!";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "Dzisiejszy dźwięk to %@. Dasz radę?";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "Scena filmowa czeka na twój głos. Światła, mikrofon, akcja!";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "Scena gotowa, publiczność rozgrzana. Zagraj rundę!";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "Ostatni dzień tygodniowego wyścigu";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "Masz w tym tygodniu %d pkt. Jeszcze jedna runda może cię wynieść wyżej!";

/* Settings switch: play fewer of the game's sound effects */
"game.settings.fewerSounds" = "Mniej efektów dźwiękowych";

/* Under that switch: what it keeps and what it drops */
"game.settings.fewerSounds.desc" = "Bez dźwięków stuknięć i przejść. Gwiazdki i fanfary zostają.";

/* Under the Sound effects switch: what the game's sounds are */
"game.settings.soundEffects.desc" = "Stuknięcia, gwiazdki, fanfary i publiczność show.";

/* Under Unlock Dubloon Pro in the game's settings: what Pro gives */
"game.settings.unlock.desc" = "Pierwsze 3 podejścia są za darmo. Z Dubloon Pro każda runda jest bez limitu.";
