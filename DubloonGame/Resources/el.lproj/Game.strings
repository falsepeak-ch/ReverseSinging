/* Dubloon the Game: the home stage. */

/* What the game-show host says on the home stage, in a speech panel above the two games */
"game.host.greeting" = "Καλώς ήρθες στο σόου! Διάλεξε παιχνίδι και ακούσου.";

/* What the host says on the home stage once the free takes are used up */
"game.host.outOfTakes" = "Τελείωσαν οι δωρεάν λήψεις! Πάρε το Pro και η σκηνή είναι δική σου.";

/* Under the app name on the home stage: 'Dubloon' / 'The Game' */
"game.subtitle" = "Το Παιχνίδι";

/* Big caption on the stage before the first attempt at a sound */
"game.imitate.prompt" = "Ζέστανε τις φωνητικές χορδές και κάνε την καλύτερη μίμηση!";

/* Which line of the scene is up, e.g. 'Line 2 of 6' */
"game.dub.lineOf" = "Ατάκα %1$d από %2$d";

/* Title of the screen where the player picks a sound to imitate */
"game.pickSound" = "Διάλεξε ήχο!";

/* Title of the screen where the player picks a movie scene to dub */
"game.pickScene" = "Διάλεξε σκηνή!";

/* Button after a result: go on to the next sound */
"game.nextSound" = "Επόμενος";

/* Why the games need the microphone, and that recordings stay on the device. Shown once, before the system asks */
"game.microphonePrimer.message" = "Και τα δύο παιχνίδια πρέπει να σε ακούν: στη μεταγλώττιση μιας σκηνής και στη μίμηση ενός ήχου. Το μικρόφωνο ξυπνά μόνο όσο ηχογραφείς, όλα μένουν σε αυτή τη συσκευή και τίποτα δεν ανεβαίνει ποτέ πουθενά. Η χειρότερη λήψη σου μένει μεταξύ σας.";

/* Big caption on the stage during the 3-2-1 count before recording */
"game.getReady" = "Ετοιμάσου…";

/* The host's lines in a round. */

/* Instruction before an impression. %@ is the sound's name, e.g. 'Cat' */
"game.host.imitate.ready" = "Άκου πρώτα τον ήχο: %@. Μετά κάνε την καλύτερη μίμησή σου!";

/* Said by the host during the 3-2-1 before recording */
"game.host.countIn" = "Πάμε… ετοιμάσου!";

/* Encouragement while the player makes the sound */
"game.host.imitate.recording" = "Πάμε, πάμε! Μη διστάζεις!";

/* Said while the take is being judged */
"game.host.scoring" = "Χμ, ας το ξανακούσω…";

/* Reaction to a top score */
"game.host.grade.top" = "Απίστευτο! Δεν σας ξεχωρίζω!";

/* Reaction to a good score */
"game.host.grade.good" = "Μπράβο! Το έχεις.";

/* Reaction to a near miss */
"game.host.grade.close" = "Παραλίγο! Άλλη μία;";

/* Playful reaction to a poor score */
"game.host.grade.rough" = "Χα! Τολμηρό… ξαναδοκίμασε!";

/* Tip when rhythm was the weakest part of an impression */
"game.host.tip.rhythm" = "Συμβουλή: πέτυχε πού ξεσπά και πού σταματά.";

/* Tip when pitch was the weakest part */
"game.host.tip.pitch" = "Συμβουλή: ακολούθησε τον τόνο πάνω-κάτω.";

/* Tip when tone was the weakest part */
"game.host.tip.tone" = "Συμβουλή: μιμήσου την υφή, αέρινη ή βουητή.";

/* Tip when length was the weakest part */
"game.host.tip.length" = "Συμβουλή: κράτησέ το όσο το πρωτότυπο.";

/* Instruction before dubbing a line. %@ is the character's name */
"game.host.dub.ready" = "Ατάκα: %@! Δες τη μία φορά και μπες ακριβώς στην αρχή.";

/* Encouragement while the player dubs a line */
"game.host.dub.recording" = "Σειρά σου! Κράτα τον ρυθμό!";

/* Tip when timing was the weakest part of a dub */
"game.host.tip.timing" = "Συμβουλή: μπες ακριβώς όταν αρχίζει να μιλά.";

/* Tip when pacing was the weakest part of a dub */
"game.host.tip.pacing" = "Συμβουλή: κράτα τον ρυθμό των συλλαβών.";

/* Tip when delivery was the weakest part of a dub */
"game.host.tip.delivery" = "Συμβουλή: μιμήσου τα δυνατά και τα σιγανά.";

/* Said when every line of the scene is dubbed */
"game.host.dub.sceneDone" = "Στοπ! Θες να δεις τη μεταγλώττισή σου;";

/* Said on a line that already has a take, inviting another go */
"game.host.dub.again" = "Ήδη μεταγλωττισμένη! Ξανά ή επόμενη.";

/* Accessibility label of the trophy on the home stage that opens the Game Center leaderboards */
"game.leaderboards" = "Πίνακες κατάταξης";

/* Title of the card that explains reminders before iOS asks for notification permission */
"game.reminder.primer.title" = "Μη χάσεις το σόου";

/* Body of that card: what the reminders are and that they can be turned off in Settings */
"game.reminder.primer.body" = "Θα σου θυμίζω το βράδυ έναν ήχο να δοκιμάσεις και πριν λήξει ο εβδομαδιαίος αγώνας. Μπορείς να το απενεργοποιήσεις στις Ρυθμίσεις όποτε θέλεις.";

/* The card's only button; it opens the iOS notification prompt */
"game.reminder.primer.continue" = "Συνέχεια";

/* Title of the evening reminder notification */
"game.reminder.show.title" = "Ώρα για σόου!";

/* Evening reminder naming a sound to imitate. %@ is the sound's name */
"game.reminder.show.sound" = "Ο ήχος της βραδιάς είναι: %@. Θα τα καταφέρεις;";

/* Evening reminder inviting the player to dub a movie scene */
"game.reminder.show.scene" = "Μια κινηματογραφική σκηνή περιμένει τη φωνή σου. Φώτα, μικρόφωνο, πάμε!";

/* Evening reminder when there is no particular sound to name */
"game.reminder.show.stage" = "Η σκηνή είναι έτοιμη και το κοινό ζεσταμένο. Έλα να παίξεις έναν γύρο!";

/* Title of the Sunday reminder that the weekly leaderboard ends tomorrow */
"game.reminder.race.title" = "Τελευταία μέρα του εβδομαδιαίου αγώνα";

/* Body of that reminder. %d is the player's points this week */
"game.reminder.race.body" = "Έχεις %d πόντους αυτή την εβδομάδα. Ένας γύρος ακόμα μπορεί να σε ανεβάσει!";

/* Settings switch: play fewer of the game's sound effects */
"game.settings.fewerSounds" = "Λιγότερα ηχητικά εφέ";

/* Under that switch: what it keeps and what it drops */
"game.settings.fewerSounds.desc" = "Χωρίς ήχους πατήματος και μετάβασης. Τα αστέρια και οι φανφάρες μένουν.";

/* Under the Sound effects switch: what the game's sounds are */
"game.settings.soundEffects.desc" = "Πατήματα, αστέρια, φανφάρες και κοινό του σόου.";

/* Under Unlock Dubloon Pro in the game's settings: what Pro gives */
"game.settings.unlock.desc" = "Οι 3 πρώτες λήψεις είναι δωρεάν. Με το Dubloon Pro κάθε γύρος είναι απεριόριστος.";

/* Help, in the game's words. Same keys as the shared Help; the game reads these first. */
"help.gettingStarted.1.q" = "Τι είναι το Dubloon the Game;";
"help.gettingStarted.1.a" = "Ένα σόου φωνητικών παιχνιδιών με δύο παιχνίδια. Μεταγλώττιση σκηνής: βάλε τη φωνή σου σε σκηνή ταινίας, ατάκα την ατάκα, και πάρε βαθμολογία. Μίμηση ήχων: μιμήσου έναν ήχο και κέρδισε έως τρία αστέρια. Ο παρουσιαστής σε οδηγεί σε κάθε γύρο.";
"help.gettingStarted.2.q" = "Είναι δωρεάν;";
"help.gettingStarted.2.a" = "Και τα δύο παιχνίδια παίζονται δωρεάν. Οι 3 πρώτες λήψεις σου είναι δωρεάν, και μετριούνται και στα δύο παιχνίδια μαζί. Μετά, κάθε σκηνή και κάθε ήχος ανοίγουν ακόμα, και το Dubloon Pro σε αφήνει να ηχογραφείς χωρίς όριο.";
"help.dub.1.q" = "Πώς μεταγλωττίζω μια σκηνή;";
"help.dub.1.a" = "Άνοιξε τη Μεταγλώττιση σκηνής και διάλεξε μια σκηνή. Σε κάθε ατάκα, πάτα το ηχείο για να ακούσεις το πρωτότυπο και μετά πάτα το μικρόφωνο: έχεις τρεις χτύπους μέτρημα, και το μικρόφωνο κλείνει μόνο του όταν τελειώσει η ατάκα. Χρησιμοποίησε τα βελάκια για να πας από ατάκα σε ατάκα.";
"help.dub.4.q" = "Πώς βλέπω ή μοιράζομαι τη μεταγλώττισή μου;";
"help.dub.4.a" = "Στην τελευταία ατάκα, πάτα Δες τη μεταγλώττισή μου για να δεις τις λήψεις σου μέσα στην ταινία. Πάτα Φτιάξε βίντεο για ένα κάθετο βίντεο έτοιμο για TikTok, Reels or Shorts, με το υλικό του Booth Cam κάτω από τη σκηνή αν έχεις τραβήξει.";
"help.imitate.1.q" = "Πώς λειτουργεί η Μίμηση ήχων;";
"help.imitate.1.a" = "Διάλεξε έναν ήχο, πάτα το ηχείο για να τον ακούσεις, μετά πάτα το μικρόφωνο και κάνε τον ήχο μόνος σου. Ο παρουσιαστής βαθμολογεί ρυθμό, τόνο, χροιά και διάρκεια και ανάβει έως τρία αστέρια. Κρατιέται η καλύτερή σου επίδοση, οπότε μπορείς να γυρίσεις και να τη ξεπεράσεις.";
"help.imitate.3.q" = "Μπορώ να μοιραστώ μια προσπάθεια;";
"help.imitate.3.a" = "Ναι. Μετά από μια βαθμολογία, πάτα Φτιάξε βίντεο: ένα κάθετο βίντεο με τον ήχο, την προσπάθειά σου και τη βαθμολογία σου. Με το Booth Cam ενεργό, μπαίνει και το πρόσωπό σου.";
"help.booth.1.q" = "Τι είναι το Booth Cam;";
"help.booth.1.a" = "Το Booth Cam βιντεοσκοπεί το πρόσωπό σου με την μπροστινή κάμερα όσο παίζεις, ώστε η αντίδρασή σου να μπει στο βίντεο. Ενεργοποίησέ το με το πλήκτρο κάμερας πάνω από τον γύρο ή από τις Ρυθμίσεις. Το υλικό μένει στη συσκευή σου.";
"help.booth.2.q" = "Πώς φτιάχνω ένα βίντεο;";
"help.booth.2.a" = "Στη Μεταγλώττιση σκηνής, φτάσε στην τελευταία ατάκα και πάτα Φτιάξε βίντεο. Στη Μίμηση ήχων, πάτα Φτιάξε βίντεο μετά από μια βαθμολογία. Και τα δύο φτιάχνουν κάθετο βίντεο για TikTok, Reels or Shorts. Πριν δημιουργηθεί μια μεταγλώττιση, το παιχνίδι δείχνει ποιανού είναι η σκηνή, ώστε να κρατήσεις την πίστωση όταν μοιράζεσαι.";
"help.pro.1.q" = "Τι ξεκλειδώνει το Dubloon Pro;";
"help.pro.1.a" = "Απεριόριστες λήψεις και στα δύο παιχνίδια, τη Μεταγλώττιση σκηνής και τη Μίμηση ήχων. Χωρίς αυτό, οι 3 πρώτες λήψεις σου είναι δωρεάν. Το Pro είναι εφάπαξ αγορά ή συνδρομή. Ανήκει σε αυτό το παιχνίδι: μια αγορά στην εφαρμογή Dubloon δεν μεταφέρεται.";
"help.troubleshooting.1.q" = "Το παιχνίδι δεν με ακούει.";
"help.troubleshooting.1.a" = "Έλεγξε ότι το παιχνίδι έχει πρόσβαση στο μικρόφωνο: στην εφαρμογή Ρυθμίσεις, άνοιξε το Dubloon Game και ενεργοποίησε το Μικρόφωνο. Αν άλλη εφαρμογή χρησιμοποιεί τον ήχο, όπως μια κλήση, τερμάτισέ την και δοκίμασε ξανά.";
"help.troubleshooting.4.q" = "Το Booth Cam δεν ανοίγει.";
"help.troubleshooting.4.a" = "Το παιχνίδι χρειάζεται την κάμερα γι' αυτό. Στην εφαρμογή Ρυθμίσεις, άνοιξε το Dubloon Game και ενεργοποίησε την Κάμερα.";
