"mac.panel.mix" = "Miks";
"mac.menu.help" = "Dubloon Yardım";
"mac.homeVideo.limit" = "En fazla bir dakika. Videon bu Mac'te kalır.";
"mac.homeVideo.hint.empty" = "Sesini üzerine koymak için Fotoğraflar'dan ya da Finder'dan bir video seç.";
"help.gettingStarted.1.a.mac" = "Sadece mikrofonuna ihtiyaç duyan dört ses oyunu. Tersten şarkı: bir şarkıyı tersten söyle. Sahne seslendirme: bir film sahnesine replik replik sesini koy. Kendi videolarını seslendir: çektiğin bir videoya sesini koy. Ses taklidi: bir sesi taklit et ve hükmü öğren. Kenar çubuğundan birini seç ya da ⌘1 ile ⌘4 arasına bas.";
"help.gettingStarted.3.a.mac" = "Hayır, ama seslendirirken işe yarar. Kulaklık takılıyken, kaydederken orijinal repliği duyabilirsin (Dubloon ▸ Ayarlar ▸ Kayıt bölümünde Kulaklıkta orijinal'i aç). Hoparlörlerden çalsa senin çekimine karışırdı, bu yüzden Dubloon onu yalnızca kulaklıkta çalar. Zamanlamayı en sıkı kablolu kulaklık tutar: Bluetooth küçük bir gecikme ekler.";
"help.reverse.1.a.mac" = "Ses kaydet'i tıkla (ya da R'ye bas) ve bir şarkıdan bir satır söyle. Tersten duymak için Ters parçasını oynat. Sonra Şimdi sen söyle'yi tıkla ve o ters sesi olabildiğince yakından taklit et. Dubloon kopyanı ters çevirir; doğru yaptıysan şarkıyı yeniden, kendi sesinle duyarsın.";
"help.reverse.4.q.mac" = "Ters satırı yavaşlatabilir miyim?";
"help.reverse.4.a.mac" = "Evet. Sağdaki denetçide (⌥⌘I) Ses kontrolleri var: döngü, hız ve perde. Ters satırı yavaşlatmak onu öğrenmenin en iyi yolu.";
"help.reverse.5.a.mac" = "Kenar çubuğunda, Tersten şarkı'nın altında. Yeni bir oturum başlatınca (⌘N) mevcut oturum oraya gider, yani hiçbir şey atılmaz. Silmek için bir oturumu seçip ⌘⌫'ye bas ya da Control tuşuna basarak oturumu tıkla.";
"help.dub.1.a.mac" = "Kenar çubuğunda Sahne seslendirme'nin altından bir sahne seç. Bir replik seç, orijinali dinlemek için L'ye, sonra kaydetmek için R'ye bas: üç vuruşluk geri sayım gelir ve replik bitince mikrofon kendiliğinden kapanır. Replikler arasında ↑ ve ↓ ile geç, istediğin zaman herhangi bir repliğe geri dön.";
"help.dub.3.a.mac" = "Her çekim zamanlama (orijinalle birlikte başlayıp bitirdin mi), tempo (ritmini korudun mu) ve oyunculuk (yüksek ve alçak yerlerin onu izledi mi) üzerinden değerlendirilir. Sahne de en iyi repliğin ve bir daha denemeye değer olanla birlikte bir puan alır. Yargılanmak istemiyor musun? Araç çubuğunda, denetçide ya da Ayarlar'da Çekimlerimi puanla'yı kapat.";
"help.dub.4.a.mac" = "Görüntüleyiciyi Benim seslendirmem'e (⌃⌘3) geçir ve Boşluk çubuğuna bas. Çekimlerin filmde orijinal repliklerin yerine geçer; henüz seslendirmediğin her şey olduğu gibi çalar. Orijinal (⌃⌘2), sahneyi dokunulmamış hâliyle oynatır.";
"help.homeVideo.1.a.mac" = "Fotoğraflar'dan ya da bir dosyadan en fazla bir dakikalık bir video seç ya da onu görüntüleyiciye bırak. R'ye bas: geri sayımdan sonra video baştan oynar ve sesin üstüne eklenir. Sonunda senin versiyonun oynar; paylaşabilir (⌘E) ya da yeniden kaydedebilirsin.";
"help.homeVideo.3.a.mac" = "Evet, kulaklıkla. Hoparlörlerde video sessiz oynar, böylece sesi kaydına karışmaz. Denetçideki Orijinal sesi koru, bitmiş videoda onu sesinin altına, kısık olarak geri koyar.";
"help.booth.1.a.mac" = "Booth Cam sen oynarken yüzünü Mac'inin kamerasıyla çeker, böylece tepkin seslendirmeyle birlikte videoya girebilir. Araç çubuğundaki kamera düğmesiyle (⇧⌘C) ya da Ayarlar'dan açana kadar kapalıdır. Görüntüler Mac'inde kalır.";
"help.booth.2.a.mac" = "Bir sahnedeyken Dosya ▸ Dışa aktar'ı seç (⌘E). Kurguyu seç (sahnenin tamamı ya da yalnızca seslendirdiğin repliklerden oluşan bir oturum makarası) ve kabin görüntülerinin nereye gideceğini belirle: köşede, hikâye için üst üste, tepki olarak ya da yan yana. Dubloon, render almadan önce sahnenin kime ait olduğunu gösterir; böylece paylaşırken künyeyi koruyabilirsin.";
"help.booth.3.a.mac" = "Dubloon ▸ Ayarlar ▸ Kayıt, kabin görüntülerinin ne kadar yer kapladığını ve tüm kabin çekimlerini silmek için bir düğme gösterir. Ses çekimlerin ve seslendirmelerin kalır. Bir sahneyi silmek onun çekimlerini ve görüntülerini de siler.";
"help.packs.1.a.mac" = "Sahneler dublaj paketi olarak gelir: bir klasör ya da .zip, .7z veya .rar arşivi. Dosya ▸ Dublaj paketi içe aktar'ı seç (⌘O), dosyayı kenar çubuğundaki Sahne seslendirme'nin üstüne bırak ya da Finder'dan Dubloon ile aç. Dubloon paketi açar ve sahne listede belirir.";
"help.packs.3.a.mac" = "Dubloon neyin ters gittiğini söyler. Genelde işe yarayanlar: dosya iCloud Drive'daysa önce Finder'da indir. Arşivin parolası varsa yapımcısından parolasız bir kopya iste. Açılmıyorsa .zip olarak yeniden kaydet. Dubloon bunun bir dublaj paketi olmadığını söylüyorsa, her replik için bir metin dosyası ve bir kayıt gerekir.";
"help.imitate.1.a.mac" = "Tarayıcıda bir ses seç, dinlemek için L'ye, sonra taklit etmek için R'ye bas. Dubloon denemeni gerçeğiyle karşılaştırır ve üstüne hükmünü basar. Her ses için en iyi puanın saklanır, yani geri dönüp onu geçebilirsin.";
"help.imitate.3.a.mac" = "Evet. Hükümden sonra Video yap'ı tıkla (⌘E): ses, denemen ve puanın, göndermeye hazır. Booth Cam açıksa yüzün de içinde olur.";
"help.pro.2.a.mac" = "Dubloon ▸ Ayarlar ▸ Dubloon Pro'yu aç ve Satın almayı geri yükle'yi tıkla. App Store'a, satın alırken kullandığın Apple Hesabı ile giriş yaptığından emin ol. Yeni bir Mac'te ya da yeniden yükledikten sonra geri yükleme onu ücretsiz geri getirir.";
"help.pro.3.a.mac" = "Dubloon ▸ Ayarlar ▸ Dubloon Pro'da Aboneliği yönet'i tıkla. Bunu App Store'dan da yapabilirsin: adını, sonra Hesap Ayarları'nı, sonra Abonelikler'i tıkla. Yenilenmeden en az 24 saat önce iptal edersen, ödediğin dönemin sonuna kadar Pro sende kalır. İadeleri Apple yönetir.";
"help.privacy.1.a.mac" = "Hayır. Kayıtların, çekimlerin, kabin görüntülerin ve videoların, sen paylaşmayı seçene kadar Mac'inde kalır. Puanlama da Mac'inde yapılır. Hesap yok, üye olunacak bir şey de yok.";
"help.privacy.2.a.mac" = "Hataları bulmaya ve sırada ne yapılacağına karar vermeye yardımcı olan anonim kullanım istatistikleri ve çökme raporları: hangi oyunun açıldığı, hangi puanın çıktığı gibi şeyler, asla bir kaydın sesi değil. Dubloon ▸ Ayarlar ▸ Genel'de Kullanım verilerini paylaş ile kapatabilirsin. Tüm ayrıntılar Gizlilik politikası'nda.";
"help.troubleshooting.1.a.mac" = "Dubloon'un mikrofonu kullanabildiğinden emin ol: Sistem Ayarları ▸ Gizlilik ve Güvenlik ▸ Mikrofon'da Dubloon'u aç. Sistem Ayarları ▸ Ses'teki girişi de denetle ve mikrofonu başka bir uygulamanın, örneğin bir aramanın, kullanmadığından emin ol.";
"help.troubleshooting.2.a.mac" = "Sesi aç ve Sistem Ayarları ▸ Ses'teki çıkışı denetle: Bluetooth kulaklık ya da bir hoparlör bağlanmış olabilir. Kayıt sırasında orijinal replik bilerek yalnızca kulaklıkta çalar, böylece çekimine karışmaz.";
"help.troubleshooting.4.a.mac" = "Dubloon'un bunun için kameraya ihtiyacı var. Sistem Ayarları ▸ Gizlilik ve Güvenlik ▸ Kamera'da Dubloon'u aç. Booth Cam, Dubloon Pro'nun bir parçası.";
"dubGuide.2.detail.mac" = "Download'a tıkla ve dosyayı seç: .zip, .7z veya .rar. Tarayıcın onu İndirilenler klasörüne kaydeder.";
"dubGuide.3.detail.mac" = "İndirme tamamlanana kadar bekle. Dosya iCloud Drive'daysa, gerçekten bu Mac'te olması için önce Finder'da indir.";
"dubGuide.4.detail.mac" = "Buraya dön, Paket içe aktar'a tıkla ve İndirilenler'den seç. Dosyayı kenar çubuğundaki Sahne seslendirme'nin üzerine bırakabilir ya da Finder'dan Dubloon ile açabilirsin.";
