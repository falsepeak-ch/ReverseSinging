"onboarding.welcome.title" = "Vítej v Dubloonu";
"onboarding.welcome.message" = "Čtyři hry, jeden mikrofon. Zazpívej písničku pozpátku, strč vlastní hlas do filmové scény nebo do vlastního videa, nebo napodobuj zvuk, dokud nesedí. Normálně nebudeš znít ani v jednom případě.";
