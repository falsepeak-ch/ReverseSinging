require "json"
require "shellwords"
require "tmpdir"

default_platform(:ios)

# Same App Store Connect key as the other False Peak apps (team 4YGWZWHTHM).
# The .p8 itself is gitignored. copy it in once:
#   cp ../Impostor/fastlane/AuthKey_DGSCB63J99.p8 fastlane/
APP_IDENTIFIER = "com.falsepeak.reverse-singing-ios"
ASC_KEY_ID    = "DGSCB63J99"
ASC_ISSUER_ID = "59e10bb5-bb9e-43ce-b654-26849e933f8c"
ASC_KEY_PATH  = File.expand_path("AuthKey_#{ASC_KEY_ID}.p8", __dir__)

# App Store Connect files both 6.7" and 6.9" iPhones under IPHONE_67. Screenshots go up
# at 1320x2868; previews must be 1290x2796 or 886x1920, and anything else is dropped
# without an error.
PREVIEW_TYPE = "IPHONE_67"
APP_RATING_CONFIG_PATH = File.expand_path("app_rating_config.json", __dir__)

# Reverso is free with no in-app purchases, so there is no pricing lane here ,
# unlike the-feel-ios, which syncs a paid-upfront tier on every metadata push.

platform :ios do
  before_all do |lane|
    # Screenshot and preview generation are entirely local. don't demand credentials.
    next if [:screenshots, :preview].include?(lane)

    unless File.exist?(ASC_KEY_PATH)
      UI.user_error!(
        "Missing #{ASC_KEY_PATH}.\n" \
        "Copy the key in:  cp ../Impostor/fastlane/AuthKey_#{ASC_KEY_ID}.p8 fastlane/"
      )
    end

    @api_key = app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_PATH
    )
  end

  desc "Generate device-framed, upload-ready App Store screenshots (local only)"
  # Local/ is deliberately untracked. see Local/docs/TOOLING.md. A clone that has never had it will hit
  # these lanes with a bare "no such file" from sh, which reads like a broken Fastfile rather
  # than a missing prerequisite. Say which it is.
  def self.require_tooling!(script)
    return if File.exist?(File.join("..", script))

    UI.user_error!(
      "#{script} is missing.\n\n" \
      "Local/ is not tracked in git (see Local/docs/TOOLING.md). This lane needs it present. " \
      "Copy it in from a machine that has it, then run this lane again."
    )
  end

  desc "Options: locales:en,ja screens:dubRecord,home skip_build:true frame_only:true raw_only:true"
  lane :screenshots do |options|
    args = []
    args << "--locales #{options[:locales]}" if options[:locales]
    args << "--screens #{options[:screens]}" if options[:screens]
    args << "--skip-build" if options[:skip_build]
    args << "--frame-only" if options[:frame_only]
    args << "--raw-only"   if options[:raw_only]

    require_tooling!("Local/Tools/screenshots/run.sh")

    Dir.chdir("..") do
      sh("./Local/Tools/screenshots/run.sh #{args.join(' ')}".strip)
    end

    UI.success("Screenshots ready in fastlane/screenshots/. run `fastlane upload_screenshots`")
  end

  desc "Record the App Store app preview video, one per locale (local only)"
  desc "Options: locales:en,ja skip_build:true"
  lane :preview do |options|
    args = []
    args << "--locales #{options[:locales]}" if options[:locales]
    args << "--skip-build" if options[:skip_build]

    require_tooling!("Local/Tools/screenshots/record.sh")

    Dir.chdir("..") do
      sh("./Local/Tools/screenshots/record.sh #{args.join(' ')}".strip)
    end

    # `deliver` does not handle app previews. it only scans the screenshots folder for
    # images. The upload goes through spaceship directly; see the upload_previews lane.
    UI.success("App previews ready in fastlane/screenshots/. run `fastlane upload_previews`")
  end

  desc "Download the screenshots currently live on the App Store, into fastlane/live/"
  desc "Read-only. nothing is written to App Store Connect. Use it to diff before uploading."
  lane :download_current do
    # `deliver` only exposes downloading through its own CLI, not as an action, and that
    # CLI wants the key as a JSON file rather than the object `before_all` builds.
    key = {
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key: File.read(ASC_KEY_PATH),
      in_house: false
    }
    key_json = File.join(Dir.tmpdir, "asc_key_#{ASC_KEY_ID}.json")
    File.write(key_json, JSON.pretty_generate(key))

    begin
      Dir.chdir("..") do
        FileUtils.mkdir_p("fastlane/live/screenshots")
        sh("bundle exec fastlane deliver download_screenshots " \
           "--api_key_path #{key_json.shellescape} " \
           "--app_identifier #{APP_IDENTIFIER.shellescape} " \
           "--screenshots_path ./fastlane/live/screenshots")
      end
    ensure
      File.delete(key_json) if File.exist?(key_json)
    end

    UI.success("Live screenshots in fastlane/live/screenshots/")
  end

  desc "Upload metadata only (no binary, no screenshots)"
  lane :metadata do
    deliver(
      api_key: @api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      app_rating_config_path: APP_RATING_CONFIG_PATH,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Upload screenshots and app previews only"
  lane :upload_screenshots do
    # One thread, deliberately.
    #
    # deliver uploads locales in parallel and its per-device "already uploaded" bookkeeping
    # races: a first run of this lane put ten screenshots into en-US and pt-PT. duplicates ,
    # then logged "Too many screenshots found for device APP_IPHONE_67" and skipped the real
    # ones. Serial is a minute slower and correct.
    ENV["DELIVER_NUMBER_OF_THREADS"] = "1"

    deliver(
      api_key: @api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      force: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Upload the App Store app preview videos"
  desc "Separate from upload_screenshots because `deliver` has no app-preview support at all ,"
  desc "it scans the screenshots folder for images only. This talks to the API directly."
  lane :upload_previews do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      filepath: ASC_KEY_PATH
    )

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("No app found for #{APP_IDENTIFIER}") if app.nil?

    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No editable App Store version. create one in App Store Connect first") if version.nil?

    root = File.expand_path("screenshots", __dir__)

    # Fetched with appPreviewSets included, rather than asking each localization for its
    # sets afterwards: `get_app_preview_sets` issues GET /appPreviewSets, and Apple no
    # longer allows GET_COLLECTION on that resource. only CREATE, DELETE and GET_INSTANCE.
    localizations = Spaceship::ConnectAPI::AppStoreVersionLocalization.all(
      app_store_version_id: version.id,
      includes: "appPreviewSets"
    )

    localizations.each do |localization|
      path = File.join(root, localization.locale, "00_preview.mp4")
      unless File.exist?(path)
        UI.important("No preview for #{localization.locale}, skipping")
        next
      end

      # One set per device size. Clear it first: uploading into a set that already holds a
      # preview appends rather than replaces, and the store would show both.
      (localization.app_preview_sets || []).each do |existing|
        next unless existing.preview_type == PREVIEW_TYPE
        existing.delete!
      end

      set = localization.create_app_preview_set(attributes: { previewType: PREVIEW_TYPE })

      UI.message("Uploading #{localization.locale} preview (#{(File.size(path) / 1024.0 / 1024).round(1)} MB)")
      set.upload_preview(
        path: path,
        wait_for_processing: true,
        # The poster frame. 8 seconds in is the recording bay with the picture rolling and
        # the take drawn over the reference. the frame that says what the app is. The
        # default is frame zero, which here is a list of scenes.
        frame_time_code: "00:00:08:00"
      )
    end

    # Verify, because a preview can upload cleanly and then fail Apple's processing with
    # nothing said. That is how the first attempt at these went out: the videos had no
    # audio track, App Store Connect accepted every byte and then marked each asset
    # FAILED / MOV_RESAVE_STEREO, which is only visible by reading the delivery state back.
    failures = []
    Spaceship::ConnectAPI::AppStoreVersionLocalization.all(
      app_store_version_id: version.id,
      includes: "appPreviewSets"
    ).each do |localization|
      (localization.app_preview_sets || []).each do |summary|
        full = Spaceship::ConnectAPI::AppPreviewSet.get(app_preview_set_id: summary.id)
        (full.app_previews || []).each do |preview|
          state = preview.asset_delivery_state || {}
          next if state["state"] == "COMPLETE"
          errors = (state["errors"] || []).map { |e| e["code"] }.join(", ")
          failures << "#{localization.locale}: #{state['state']} #{errors}"
        end
      end
    end

    if failures.empty?
      UI.success("App previews uploaded and processed for all locales")
    else
      UI.user_error!("App previews failed processing:\n  " + failures.join("\n  "))
    end
  end

  desc "Upload metadata and screenshots"
  lane :upload_all do
    deliver(
      api_key: @api_key,
      skip_binary_upload: true,
      app_rating_config_path: APP_RATING_CONFIG_PATH,
      force: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "Build and upload a build to TestFlight"
  lane :beta do
    increment_build_number
    build_app
    upload_to_testflight(
      api_key: @api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and upload to App Store with metadata and screenshots (does not submit for review)"
  lane :release do
    increment_build_number
    build_app
    deliver(
      api_key: @api_key,
      app_rating_config_path: APP_RATING_CONFIG_PATH,
      force: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
  end
end
